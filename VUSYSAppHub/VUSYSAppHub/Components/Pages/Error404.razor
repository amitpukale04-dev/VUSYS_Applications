@page "/404"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>404 - Page Not Found</PageTitle>

<div class="apphub-page @(isDarkMode ? "dark-mode" : "")" data-bs-theme="@(isDarkMode ? "dark" : "light")">
    <div class="container-fluid px-3 px-md-4 px-lg-5 py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 monitoring-page-header">
            <div>
                <h2 class="page-title mb-1">404 - Page Not Found</h2>
                <div class="page-note">The page you are looking for does not exist or may have been moved.</div>
            </div>

            <div class="monitoring-header-actions">
                <button type="button"
                        class="btn btn-back-dashboard d-inline-flex align-items-center gap-2"
                        @onclick="GoHome">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Back to App Hub</span>
                </button>

                <button type="button"
                        class="btn btn-theme d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                        style="width: 56px; height: 56px; padding: 0;"
                        title="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        aria-label="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        @onclick="ToggleThemeAsync">
                    <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill") fs-4"></i>
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm monitoring-dashboard-card">
            <div class="monitoring-dashboard-header">
                <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="monitoring-dashboard-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <h4 class="monitoring-dashboard-title mb-1">Oops! Page Not Found</h4>
                            <div class="monitoring-dashboard-subtitle">
                                Error Code: 404
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-dashboard-right">
                        <div class="monitoring-refresh-pill">
                            <span class="monitoring-refresh-dot"></span>
                            <span>Requested page unavailable</span>
                        </div>

                        <div class="monitoring-last-refresh">
                            <i class="bi bi-link-45deg me-1"></i>
                            Invalid or unavailable route
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-lg-5">
                <div class="text-center py-4 py-lg-5">
                    <div class="mb-4">
                        <i class="bi bi-file-earmark-x-fill" style="font-size: 5rem; color: var(--vusys-primary);"></i>
                    </div>

                    <h1 class="fw-bold mb-3" style="font-size: 4rem; color: var(--vusys-primary);">404</h1>

                    <h3 class="mb-3">The requested page was not found</h3>

                    <p class="text-muted mb-4 mx-auto" style="max-width: 720px;">
                        The page you requested could not be found. It may have been removed, renamed,
                        or the URL may be incorrect.
                    </p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <button type="button"
                                class="btn btn-monitoring-dashboard d-inline-flex align-items-center gap-2"
                                @onclick="GoHome">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Go to Home</span>
                        </button>

                        <button type="button"
                                class="database-btn-secondary d-inline-flex align-items-center gap-2"
                                @onclick="GoBack">
                            <i class="bi bi-arrow-left-circle"></i>
                            <span>Go Back</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await JS.InvokeAsync<bool>("themeManager.getCurrentThemeIsDark");
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        isDarkMode = await JS.InvokeAsync<bool>("themeManager.toggleTheme");
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}