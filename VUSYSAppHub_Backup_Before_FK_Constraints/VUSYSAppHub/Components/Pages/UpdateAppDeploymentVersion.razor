    private bool HasValidSelections()
    {
        return !string.IsNullOrWhiteSpace(selectedApplication) &&
               !string.Equals(selectedApplication, DefaultSelectText, StringComparison.OrdinalIgnoreCase) &&
               !string.IsNullOrWhiteSpace(selectedEnvironment) &&
               !string.Equals(selectedEnvironment, DefaultSelectText, StringComparison.OrdinalIgnoreCase);
    }

    private bool ValidateSelections()
    {
        if (string.IsNullOrWhiteSpace(selectedApplication) ||
            string.Equals(selectedApplication, DefaultSelectText, StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Please select Application.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(selectedEnvironment) ||
            string.Equals(selectedEnvironment, DefaultSelectText, StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Please select Environment.";
            return false;
        }

        return true;
    }

    private string GetActionStatusText()
    {
        if (isBusy && currentAction == "load")
