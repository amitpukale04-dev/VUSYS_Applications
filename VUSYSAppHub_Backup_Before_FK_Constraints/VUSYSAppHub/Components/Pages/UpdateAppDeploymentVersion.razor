    private async Task ValidateLoginAndSendOtpAsync()
    {
        try
        {
            loginPopupErrorMessage = string.Empty;
            loginPopupInfoMessage = string.Empty;

            if (!ValidateSelections())
                return;

            if (string.IsNullOrWhiteSpace(loginIdInput))
            {
                loginPopupErrorMessage = "Please enter Login ID.";
                return;
            }

            isPopupBusy = true;
            currentPopupAction = "send-otp";

            var objEmployeeLoginValidationRequestModel = new EmployeeLoginValidationRequestModel
            {
                ApplicationName = selectedApplication,
                EnvironmentName = selectedEnvironment,
                LoginID = loginIdInput,
            };

            var validationResult = await UpdateDeploymentVersionService.ValidateLoginIdAsync(objEmployeeLoginValidationRequestModel);

            if (!validationResult.IsValid)
            {
                loginPopupErrorMessage = string.IsNullOrWhiteSpace(validationResult.ErrorMessage)
                    ? "Invalid Login ID."
                    : validationResult.ErrorMessage;

                return;
            }

            if (string.IsNullOrWhiteSpace(validationResult.EmailId))
            {
                loginPopupErrorMessage = "Email ID is not configured for this Login ID.";
                return;
            }

            validatedEmployee = validationResult;

            await SendAndStoreOtpAsync(isResend: false);

            showLoginPopup = false;
            showOtpPopup = true;
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = $"OTP has been sent to {validatedEmployee.EmailId}.";
            ClearOtpInputs();
            focusFirstOtpBoxPending = true;
        }
        catch (Exception ex)
        {
            loginPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResendOtpAsync()
    {
        try
        {
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.Empty;

            if (!validatedEmployee.IsValid ||
                string.IsNullOrWhiteSpace(validatedEmployee.LoginId) ||
                string.IsNullOrWhiteSpace(validatedEmployee.EmailId))
            {
                otpPopupErrorMessage = "Validated employee details not found. Please start the process again.";
                return;
            }

            isPopupBusy = true;
            currentPopupAction = "resend-otp";

            await SendAndStoreOtpAsync(isResend: true);

            otpPopupInfoMessage = $"A new OTP has been sent to {validatedEmployee.EmailId}.";
            ClearOtpInputs();
            focusFirstOtpBoxPending = true;
        }
        catch (Exception ex)
        {
            otpPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendAndStoreOtpAsync(bool isResend)
    {
        var otp = GenerateSixDigitOtp();
        var expiryMinutes = Convert.ToInt32(CommonHelper.KeyOption.OTPExpiryInMinutes);
        var expiryUtc = DateTime.UtcNow.AddMinutes(expiryMinutes);

        var storageModel = new DeploymentVersionOtpStorageModel
        {
            LoginId = validatedEmployee.LoginId,
            EmployeeName = validatedEmployee.EmployeeName,
            EmailId = validatedEmployee.EmailId,
            Otp = otp,
            ExpiryUtc = expiryUtc,
            ApplicationName = selectedApplication,
            Environment = selectedEnvironment,
            NewVersion = newVersion
        };

        var objDeploymentSendOtpModel = new DeploymentSendOtpModel
        {
            ApplicationName = selectedApplication,
            Environment = selectedEnvironment,
            LoginId = validatedEmployee.LoginId,
            EmployeeName = validatedEmployee.EmployeeName,
            EmailId = validatedEmployee.EmailId,
            Otp = otp,
            ExpiryInMinutes = Convert.ToString(expiryMinutes),
            NewVersion = newVersion
        };

        await UpdateDeploymentVersionService.SendDeploymentOtpAsync(objDeploymentSendOtpModel);

        await JS.InvokeVoidAsync("appHubOtp.storeOtp", OtpStorageKey, storageModel);
    }

    private async Task VerifyOtpAndUpdateAsync()
    {
        try
        {
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.Empty;

            var enteredOtp = string.Concat(otpDigits);

            if (string.IsNullOrWhiteSpace(enteredOtp) || enteredOtp.Length != 6 || enteredOtp.Any(x => !char.IsDigit(x)))
            {
                otpPopupErrorMessage = "Please enter valid 6-digit OTP.";
                return;
            }

            isPopupBusy = true;
            currentPopupAction = "verify-otp";

            var storedOtp = await JS.InvokeAsync<DeploymentVersionOtpStorageModel?>("appHubOtp.getOtp", OtpStorageKey);

            if (storedOtp == null)
            {
                otpPopupErrorMessage = "OTP not found. Please request OTP again.";
                return;
            }

            if (storedOtp.ExpiryUtc <= DateTime.UtcNow)
            {
                await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
                otpPopupErrorMessage = "OTP has expired. Please click Resend OTP.";
                return;
            }

            if (!string.Equals(storedOtp.ApplicationName, selectedApplication, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.Environment, selectedEnvironment, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.LoginId, validatedEmployee.LoginId, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.EmailId, validatedEmployee.EmailId, StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
                otpPopupErrorMessage = "OTP session is invalid. Please start again.";
                return;
            }

            if (!string.Equals(storedOtp.Otp, enteredOtp, StringComparison.Ordinal))
            {
                otpPopupErrorMessage = "OTP is not valid.";
                return;
            }

            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);

            showOtpPopup = false;
            showLoginPopup = false;

            await PerformVersionUpdateAsync(validatedEmployee.LoginId);
        }
        catch (Exception ex)
        {
            otpPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PerformVersionUpdateAsync(string updatedByLoginId)
    {
        try
        {
            ClearMessages();

            if (!ValidateSelections())
                return;

            if (string.IsNullOrWhiteSpace(lastVersion))
            {
                errorMessage = "Last Version is empty. Please select Application and Environment.";
                return;
            }

            if (string.IsNullOrWhiteSpace(newVersion))
            {
                errorMessage = "New Version is empty.";
                return;
            }

            isBusy = true;
            currentAction = "update";

            var model = new UpdateDeploymentVersionModel
            {
                ApplicationName = selectedApplication,
                Environment = selectedEnvironment,
                VersionNumber = newVersion,
                UpdatedBy = updatedByLoginId,
                AppUpdateBase64 = uploadedPdfBase64
            };

            var updatedVersion = newVersion;
            var result = await UpdateDeploymentVersionService.UpdateDeploymentVersionAsync(model);

            if (result)
            {
                successMessage = $"Deployment version updated successfully to {updatedVersion}.";
                lastActionAt = DateTime.Now;
                existingAppUpdateBase64 = uploadedPdfBase64;

                isBusy = false;
                currentAction = string.Empty;
                StateHasChanged();

                await ShowSuccessThenResetAsync();
                return;
            }
            else
            {
                errorMessage = "Failed to update deployment version.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
            currentAction = string.Empty;
            StateHasChanged();
        }
    }

    private async Task ShowSuccessThenResetAsync()
    {
        successMessageCts?.Cancel();
        successMessageCts?.Dispose();
        successMessageCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(SuccessMessageDisplayMilliseconds, successMessageCts.Token);

            successMessage = string.Empty;
            errorMessage = string.Empty;

            await ResetFormAndReloadDropdownsAsync();
            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

