@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IPortalAppService PortalAppService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

@using System.Net
@using System.Reflection
@using System.Text.Json
@using System.Diagnostics
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using VUSYSAppHub.Models
@using VUSYSAppHub.AppHubHelper

<PageTitle>VUSYS-App Hub</PageTitle>

<HeadContent>
	<link rel="icon" type="image/x-icon" href="favicon.ico" />
	<link rel="icon" type="image/png" href="images/AppLogo.png" />
</HeadContent>

<div class="apphub-page @(isDarkMode ? "dark-mode" : "")">
	<div class="container-fluid px-3 px-md-4 px-lg-5 py-4 py-lg-5">
		<div class="top-header card border-0 shadow-sm mb-4">
			<div class="card-body p-4">
				<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
					<div>
						<div class="d-flex align-items-center gap-3 mb-2">
							<div class="brand-logo">
								<img src="images/AppLogo.png" alt="VUSYS AppHub Logo" class="brand-logo-img" />
							</div>
							<div>
								<h1 class="page-title mb-0">VUSYS-App Hub</h1>
								<div class="page-subtitle">Central Application Launcher</div>
							</div>
						</div>
						<div class="page-note">
							Access all VUSYS applications from one page.
						</div>
					</div>

					<div class="d-flex align-items-center gap-2 flex-wrap justify-content-lg-end">
						<button type="button"
								class="btn btn-launcher d-inline-flex align-items-center gap-2"
								title="Open launcher (Ctrl + K)"
								@onclick="OpenLauncherAsync">
							<i class="bi bi-command"></i>
							<span>Launcher</span>
							<span class="launcher-shortcut-badge">Ctrl + K</span>
						</button>

						<button type="button"
								class="btn btn-theme d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
								style="width: 56px; height: 56px; padding: 0;"
								title="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
								aria-label="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
								@onclick="ToggleThemeAsync">
							<i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill") fs-4"></i>
						</button>
					</div>
				</div>
			</div>
		</div>

		<div class="filter-panel card border-0 shadow-sm mb-4">
			<div class="card-body p-4">
				<div class="row g-3 align-items-end">
					<div class="col-12 col-xl-6">
						<label class="form-label filter-label d-flex align-items-center justify-content-between gap-2">
							<span>Global Search</span>
							<button type="button"
									class="btn btn-search-shortcut"
									title="Open global launcher"
									@onclick="OpenLauncherAsync">
								<i class="bi bi-command me-1"></i>Ctrl + K
							</button>
						</label>

						<div class="search-box position-relative">
							<i class="bi bi-search search-icon"></i>

							<input id="globalSearchInput"
								   type="text"
								   class="form-control search-input with-clear-btn"
								   placeholder="Search by application name, environment..."
								   @bind="SearchText"
								   @bind:event="oninput"
								   @onfocus="HandleSearchFocus"
								   @onblur="HandleSearchBlur" />

							@if (HasActiveFilters)
							{
								<button type="button"
										class="btn search-clear-btn"
										title="Clear filters"
										@onclick="ClearAllFilters">
									<i class="bi bi-x-lg"></i>
								</button>
							}

							@if (ShowSearchSuggestions && SearchSuggestions.Any())
							{
								<div class="search-suggestion-dropdown shadow-sm">
									@foreach (var suggestion in SearchSuggestions)
									{
										<button type="button"
												class="search-suggestion-item"
												@onmousedown="@(() => SelectSuggestion(suggestion))">
											<div class="search-suggestion-top-row">
												<div class="search-suggestion-main">
													<i class="@suggestion.IconCss me-1"></i> @suggestion.Name
												</div>
												<span class="app-status-badge @GetAppStatusCssClass(suggestion)">
													<i class="@GetAppStatusIcon(suggestion) me-1"></i>@GetAppStatus(suggestion)
												</span>
											</div>
											<div class="search-suggestion-meta">
												@suggestion.ProductGroup • @suggestion.Environment
											</div>
										</button>
									}
								</div>
							}
						</div>
					</div>

					<div class="col-12 col-md-6 col-xl-3">
						<label class="form-label filter-label">Applications</label>
						<select class="form-select form-select-modern" @bind="SelectedProductGroup">
							@foreach (var item in productGroups)
							{
								<option value="@item">@item</option>
							}
						</select>
					</div>

					<div class="col-12 col-md-6 col-xl-3">
						<label class="form-label filter-label">Environments</label>
						<select class="form-select form-select-modern" @bind="SelectedEnvironment">
							@foreach (var item in environments)
							{
								<option value="@item">@item</option>
							}
						</select>
					</div>
				</div>
			</div>
		</div>

		<div class="summary-bar d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
			<div class="summary-text">
				Showing <strong>@FilteredApps.Count()</strong> application(s)
			</div>
			<div class="summary-chip-wrap">
				<span class="summary-chip">Application: @SelectedProductGroup</span>
				<span class="summary-chip">Environment: @SelectedEnvironment</span>
				<span class="summary-chip summary-chip-analytics">
					<i class="bi bi-graph-up-arrow me-1"></i>Tracked Launches: @appLaunchCounts.Values.Sum()
				</span>
			</div>
		</div>

		<div class="card border-0 shadow-sm mb-4 monitoring-dashboard-card">
			<div class="monitoring-dashboard-header">
				<div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
					<div class="d-flex align-items-center gap-3">
						<div class="monitoring-dashboard-icon">
							<i class="bi bi-hdd-network-fill"></i>
						</div>
						<div>
							<h4 class="monitoring-dashboard-title mb-1">Real-time IIS Monitoring Dashboard</h4>
							<div class="monitoring-dashboard-subtitle">
								Azure / DevOps style live overview for application health, app pools and uptime
							</div>
						</div>
					</div>

					<div class="monitoring-dashboard-right">
						<div class="monitoring-refresh-pill @(isStatusRefreshing ? "refreshing" : "")">
							<span class="monitoring-refresh-dot"></span>
							<span>@(isStatusRefreshing ? "Refreshing..." : $"Auto refresh every {StatusRefreshIntervalSeconds} sec")</span>
						</div>

						<div class="monitoring-last-refresh">
							<i class="bi bi-clock-history me-1"></i>
							@(lastStatusRefreshAt.HasValue ? $"Last refresh: {lastStatusRefreshAt.Value:dd-MMM-yyyy hh:mm:ss tt}" : "Last refresh: --")
						</div>
					</div>
				</div>
			</div>

			<div class="card-body p-4">
				<div class="monitoring-kpi-grid mb-4">
					<div class="monitoring-kpi-card monitoring-kpi-overall">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">Overall Status</div>
							<span class="monitoring-traffic-light @GetDashboardStatusCssClass()">
								<i class="bi @GetDashboardStatusIcon()"></i>
								@GetDashboardOverallStatus()
							</span>
						</div>
						<div class="monitoring-kpi-value">@TotalMonitoredApps</div>
						<div class="monitoring-kpi-meta">Monitored applications</div>
					</div>

					<div class="monitoring-kpi-card monitoring-kpi-live">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">Healthy</div>
							<span class="monitoring-dot-indicator green"></span>
						</div>
						<div class="monitoring-kpi-value">@LiveAppsCount</div>
						<div class="monitoring-kpi-meta">Green status applications</div>
					</div>

					<div class="monitoring-kpi-card monitoring-kpi-warning">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">Warning</div>
							<span class="monitoring-dot-indicator yellow"></span>
						</div>
						<div class="monitoring-kpi-value">@MaintenanceAppsCount</div>
						<div class="monitoring-kpi-meta">Yellow status applications</div>
					</div>

					<div class="monitoring-kpi-card monitoring-kpi-down">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">Critical</div>
							<span class="monitoring-dot-indicator red"></span>
						</div>
						<div class="monitoring-kpi-value">@DownAppsCount</div>
						<div class="monitoring-kpi-meta">Red status applications</div>
					</div>

					<div class="monitoring-kpi-card monitoring-kpi-pools">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">App Pools</div>
							<i class="bi bi-diagram-3-fill"></i>
						</div>
						<div class="monitoring-kpi-value">@AppPoolDashboardItems.Count</div>
						<div class="monitoring-kpi-meta">Detected / grouped pools</div>
					</div>

					<div class="monitoring-kpi-card monitoring-kpi-uptime">
						<div class="monitoring-kpi-top">
							<div class="monitoring-kpi-label">Server Uptime</div>
							<i class="bi bi-server"></i>
						</div>
						<div class="monitoring-kpi-value monitoring-kpi-value-uptime">@ServerUptimeDisplay</div>
						<div class="monitoring-kpi-meta">@ServerMachineDisplay</div>
					</div>
				</div>

				<div class="row g-4">
					<div class="col-12 col-xxl-7">
						<div class="monitoring-panel">
							<div class="monitoring-panel-header">
								<div class="monitoring-panel-title-wrap">
									<div class="monitoring-panel-title">
										<i class="bi bi-grid-1x2-fill me-2"></i>IIS Application Health
									</div>
									<div class="monitoring-panel-subtitle">
										Live status grouped from configured application endpoints
									</div>
								</div>
							</div>

							<div class="monitoring-app-grid">
								@foreach (var item in MonitoringAppCards)
								{
									<div class="monitoring-app-card @GetMonitoringCardCss(item.Status)">
										<div class="monitoring-app-card-top">
											<div class="monitoring-app-icon">
												<i class="@item.IconCss"></i>
											</div>

											<div class="monitoring-app-content">
												<div class="monitoring-app-title-row">
													<div class="monitoring-app-title">@item.Name</div>
													<span class="monitoring-traffic-light @GetMonitoringTrafficCss(item.Status)">
														<i class="bi @GetMonitoringStatusIcon(item.Status)"></i>
														@item.Status
													</span>
												</div>

												<div class="monitoring-app-meta">
													@item.ProductGroup • @item.Environment
												</div>

												@if (!string.IsNullOrWhiteSpace(item.Url))
												{
													<div class="monitoring-app-url text-truncate">@item.Url</div>
												}
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>

					<div class="col-12 col-xxl-5">
						<div class="monitoring-panel h-100">
							<div class="monitoring-panel-header">
								<div class="monitoring-panel-title-wrap">
									<div class="monitoring-panel-title">
										<i class="bi bi-cpu-fill me-2"></i>App Pool Monitoring
									</div>
									<div class="monitoring-panel-subtitle">
										Group-wise view based on AppPool/AppPoolName metadata when available
									</div>
								</div>
							</div>

							@if (AppPoolDashboardItems.Any())
							{
								<div class="monitoring-pool-list">
									@foreach (var pool in AppPoolDashboardItems)
									{
										<div class="monitoring-pool-item">
											<div class="monitoring-pool-left">
												<div class="monitoring-pool-title-row">
													<div class="monitoring-pool-title">@pool.Name</div>
													<span class="monitoring-traffic-light @GetMonitoringTrafficCss(pool.Status)">
														<i class="bi @GetMonitoringStatusIcon(pool.Status)"></i>
														@pool.Status
													</span>
												</div>

												<div class="monitoring-pool-meta">
													@pool.Environment • Server: @pool.ServerName
												</div>
											</div>

											<div class="monitoring-pool-count-wrap">
												<div class="monitoring-pool-count">@pool.AppCount</div>
												<div class="monitoring-pool-count-label">Apps</div>
											</div>
										</div>
									}
								</div>
							}
							else
							{
								<div class="monitoring-empty-state">
									<i class="bi bi-diagram-3"></i>
									<div>No app pool metadata found. Using application grouping fallback.</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>

		@if (MostUsedApps.Any())
		{
			<div class="card border-0 shadow-sm mb-4 analytics-section">
				<div class="application-section-header application-section analytics-section-header">
					<div class="d-flex align-items-center justify-content-between gap-3">
						<div class="d-flex align-items-center gap-3">
							<span class="accordion-toggle-icon">
								<i class="bi bi-bar-chart-line-fill"></i>
							</span>
							<div>
								<h4 class="application-section-title">Most Used Apps</h4>
								<div class="application-section-subtitle">
									Based on your application launch activity
								</div>
							</div>
						</div>

						<div class="application-section-count">
							Top: @MostUsedApps.Count app(s)
						</div>
					</div>
				</div>

				<div class="card-body p-4">
					<div class="most-used-grid">
						@foreach (var app in MostUsedApps)
						{
							<div class="most-used-card">
								<div class="most-used-card-top">
									<div class="most-used-icon">
										<i class="@app.IconCss"></i>
									</div>
									<div class="most-used-content">
										<div class="most-used-title-row">
											<div class="most-used-title">@app.Name</div>
											<span class="app-status-badge @GetAppStatusCssClass(app)">
												<i class="@GetAppStatusIcon(app) me-1"></i>@GetAppStatus(app)
											</span>
										</div>
										<div class="most-used-meta">@app.ProductGroup • @app.Environment</div>
										<div class="most-used-count">
											<i class="bi bi-lightning-charge-fill me-1"></i>Used @GetLaunchCount(app) time(s)
										</div>
									</div>
								</div>

								<div class="most-used-actions">
									<button type="button"
											class="btn btn-sm @(IsPinned(app) ? "btn-secondary" : "btn-outline-secondary") app-pin-link"
											title="Pin application"
											@onclick="() => TogglePinnedAppAsync(app)">
										<i class="bi @(IsPinned(app) ? "bi-pin-angle-fill" : "bi-pin-angle") me-1"></i>
										@(IsPinned(app) ? "Pinned" : "Pin")
									</button>

									<button type="button"
											class="btn btn-sm @GetOpenButtonClass(app.Environment) app-open-link"
											@onclick="() => OpenAppAsync(app)">
										<i class="bi @(app.OpenInNewTab ? "bi-box-arrow-up-right" : "bi-arrow-right-circle") me-1"></i>Open
									</button>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}

		<div class="card border-0 shadow-sm mb-4 application-section pinned-section-card">
			<div class="application-section-header">
				<div class="d-flex align-items-center justify-content-between gap-3">
					<div class="d-flex align-items-center gap-3">
						<span class="accordion-toggle-icon">
							<i class="bi bi-pin-angle-fill"></i>
						</span>
						<div>
							<h4 class="application-section-title">My Pinned List</h4>
							<div class="application-section-subtitle">
								Quick access to your pinned applications
							</div>
						</div>
					</div>

					<div class="application-section-count">
						Total: @PinnedApps.Count app(s)
					</div>
				</div>
			</div>

			<div class="card-body p-4">
				@if (PinnedApps.Any())
				{
					<div class="pinned-help-text mb-3">
						<i class="bi bi-arrow-down-up me-2"></i>Drag and drop pinned apps to reorder them.
					</div>

					<div class="row g-4">
						@foreach (var pinnedGroup in PinnedGroupedSections)
						{
							<div class="col-12 col-xl-4">
								<div class="environment-column">
									<div class="environment-column-header @AppHubHomeHelper.GetEnvironmentColumnHeaderClass(pinnedGroup.Environment)">
										<div>
											<i class="@AppHubHomeHelper.GetEnvironmentIcon(pinnedGroup.Environment) me-2"></i>@pinnedGroup.Environment
										</div>
										<span class="environment-column-count">@pinnedGroup.Apps.Count</span>
									</div>

									<div class="environment-column-body">
										<ul class="app-link-list">
											@foreach (var app in pinnedGroup.Apps)
											{
												var pinnedKey = GetAppUniqueKey(app);

												<li class="app-link-item pinned-draggable @(string.Equals(activeDragPinnedKey, pinnedKey, StringComparison.OrdinalIgnoreCase) ? "dragging" : "")"
													draggable="true"
													@ondragstart="(e) => HandlePinnedDragStart(e, app)"
													@ondragover:preventDefault
													@ondrop="() => HandlePinnedDrop(app)"
													@ondragend="HandlePinnedDragEnd">
													<div class="app-link-top">
														<div class="app-link-left">
															<div class="app-link-title-row">
																<div class="drag-handle" title="Drag to reorder">
																	<i class="bi bi-grip-vertical"></i>
																</div>

																<div class="app-link-title-content">
																	<div class="app-link-name">
																		<i class="@app.IconCss me-1"></i>@app.Name
																	</div>
																	<div class="app-link-meta-row">
																		<div class="pinned-product-name">@app.ProductGroup</div>
																		<span class="app-status-badge @GetAppStatusCssClass(app)">
																			<i class="@GetAppStatusIcon(app) me-1"></i>@GetAppStatus(app)
																		</span>
																	</div>
																</div>
															</div>
														</div>

														<div class="app-action-group">
															<button type="button"
																	class="btn btn-sm btn-outline-secondary app-pin-link"
																	title="Unpin application"
																	@onclick="() => TogglePinnedAppAsync(app)">
																<i class="bi bi-pin-angle-fill me-1"></i>Unpin
															</button>

															<button type="button"
																	class="btn btn-sm @GetOpenButtonClass(app.Environment) app-open-link"
																	@onclick="() => OpenAppAsync(app)">
																<i class="bi @(app.OpenInNewTab ? "bi-box-arrow-up-right" : "bi-arrow-right-circle") me-1"></i>Open
															</button>
														</div>
													</div>
												</li>
											}
										</ul>
									</div>
								</div>
							</div>
						}
					</div>
				}
				else
				{
					<div class="no-environment-data">
						<i class="bi bi-pin-angle me-2"></i>No pinned applications yet. Use the Pin button to add apps here.
					</div>
				}
			</div>
		</div>

		@if (GroupedApplicationSections.Any())
		{
			@foreach (var group in GroupedApplicationSections)
			{
				var isExpanded = IsSectionExpanded(group.ApplicationName);

				<div class="application-section card border-0 shadow-sm mb-4">
					<div class="application-section-header"
						 role="button"
						 tabindex="0"
						 @onclick="() => ToggleSection(group.ApplicationName)"
						 @onkeydown="(e) => HandleSectionHeaderKeyDown(e, group.ApplicationName)">
						<div class="d-flex align-items-center justify-content-between gap-3">
							<div class="d-flex align-items-center gap-3">
								<span class="accordion-toggle-icon @(isExpanded ? "rotated" : "")">
									<i class="bi bi-chevron-down"></i>
								</span>
								<div>
									<h4 class="application-section-title">@group.ApplicationName</h4>
									<div class="application-section-subtitle">
										Environment-wise application launcher
									</div>
								</div>
							</div>

							<div class="application-section-count">
								Total: @group.TotalCount app(s)
							</div>
						</div>
					</div>

					<div class="application-section-content @(isExpanded ? "expanded" : "collapsed")">
						<div class="card-body p-4">
							<div class="row g-4">
								<div class="col-12 col-xl-4">
									<div class="environment-column">
										<div class="environment-column-header environment-column-header-dev">
											<div><i class="bi bi-code-slash me-2"></i>Development</div>
											<span class="environment-column-count">@group.DevelopmentApps.Count</span>
										</div>

										<div class="environment-column-body">
											@if (group.DevelopmentApps.Any())
											{
												<ul class="app-link-list">
													@foreach (var app in group.DevelopmentApps.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
													{
														<li class="app-link-item">
															<div class="app-link-top">
																<div class="app-link-left">
																	<div class="app-link-title-row no-drag">
																		<div class="app-link-title-content">
																			<div class="app-link-name">
																				<i class="@app.IconCss me-1"></i>@app.Name
																			</div>
																			<div class="app-link-meta-row">
																				<span class="app-status-badge @GetAppStatusCssClass(app)">
																					<i class="@GetAppStatusIcon(app) me-1"></i>@GetAppStatus(app)
																				</span>
																			</div>
																		</div>
																	</div>
																</div>

																<div class="app-action-group">
																	<button type="button"
																			class="btn btn-sm @(IsPinned(app) ? "btn-secondary" : "btn-outline-secondary") app-pin-link"
																			title="Pin application"
																			@onclick="() => TogglePinnedAppAsync(app)">
																		<i class="bi @(IsPinned(app) ? "bi-pin-angle-fill" : "bi-pin-angle") me-1"></i>
																		@(IsPinned(app) ? "Pinned" : "Pin")
																	</button>

																	<button type="button"
