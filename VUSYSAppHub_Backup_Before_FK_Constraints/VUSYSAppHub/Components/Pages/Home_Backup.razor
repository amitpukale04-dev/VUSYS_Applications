	private string GetAppUniqueKey(PortalApp app)
	{
		return $"{app.ProductGroup}||{app.Environment}||{app.Name}||{app.Url}";
	}

	private PortalApp? FindAppByKey(string key)
	{
		return apps.FirstOrDefault(x => string.Equals(GetAppUniqueKey(x), key, StringComparison.OrdinalIgnoreCase));
