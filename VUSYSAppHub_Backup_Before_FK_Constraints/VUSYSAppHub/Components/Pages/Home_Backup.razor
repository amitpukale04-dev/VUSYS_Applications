<script>
	window.appHubHome = window.appHubHome || (function () {
		let hotkeyHandler = null;

		return {
			registerHotkeys: function (dotNetRef) {
				if (hotkeyHandler) return;

				hotkeyHandler = function (event) {
					const isCtrlOrMeta = event.ctrlKey || event.metaKey;
					const activeTag = (document.activeElement?.tagName || "").toLowerCase();
					const isTypingTarget = activeTag === "input" || activeTag === "textarea" || document.activeElement?.isContentEditable;

					if (isCtrlOrMeta && event.key.toLowerCase() === "k") {
						event.preventDefault();
						dotNetRef.invokeMethodAsync("OpenLauncherFromHotkey");
						return;
					}

					if (event.key === "Escape") {
						dotNetRef.invokeMethodAsync("CloseLauncherFromHotkey");
					}
				};

				document.addEventListener("keydown", hotkeyHandler);
			},

			unregisterHotkeys: function () {
				if (!hotkeyHandler) return;
				document.removeEventListener("keydown", hotkeyHandler);
				hotkeyHandler = null;
			},

			focusElementById: function (elementId) {
				const el = document.getElementById(elementId);
				if (!el) return;

				window.requestAnimationFrame(() => {
					el.focus();
					if (el.select) {
						el.select();
					}
				});
			},

			openApp: function (url, openInNewTab) {
				if (!url) return;

				if (openInNewTab) {
					window.open(url, "_blank", "noopener,noreferrer");
				} else {
					window.location.href = url;
				}
			}
		};
	})();
</script>

@code {
	private const string PinnedAppsStorageKey = "VUSYSAppHub_PinnedApps";
