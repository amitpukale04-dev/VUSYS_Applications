	private async Task LoadPinnedAppsAsync()
	{
		try
		{
			var json = await JS.InvokeAsync<string>("localStorage.getItem", PinnedAppsStorageKey);

			if (string.IsNullOrWhiteSpace(json))
			{
				pinnedAppKeys = new List<string>();
				return;
			}

			pinnedAppKeys = JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
		}
		catch
		{
			pinnedAppKeys = new List<string>();
		}
	}

	private async Task SavePinnedAppsAsync()
	{
		try
		{
			var distinctOrderedKeys = new List<string>();
			var uniqueSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

			foreach (var key in pinnedAppKeys)
			{
				if (uniqueSet.Add(key))
					distinctOrderedKeys.Add(key);
			}

			pinnedAppKeys = distinctOrderedKeys;

			var json = JsonSerializer.Serialize(pinnedAppKeys);
			await JS.InvokeVoidAsync("localStorage.setItem", PinnedAppsStorageKey, json);
		}
		catch
		{
		}
	}

	private void HandlePinnedDragStart(DragEventArgs _, PortalApp app)
	{
		activeDragPinnedKey = GetAppUniqueKey(app);
	}

	private async Task HandlePinnedDrop(PortalApp targetApp)
	{
		if (string.IsNullOrWhiteSpace(activeDragPinnedKey))
			return;

		var targetKey = GetAppUniqueKey(targetApp);

		if (string.Equals(activeDragPinnedKey, targetKey, StringComparison.OrdinalIgnoreCase))
		{
			activeDragPinnedKey = null;
			return;
		}

		var dragIndex = pinnedAppKeys.FindIndex(x => string.Equals(x, activeDragPinnedKey, StringComparison.OrdinalIgnoreCase));
		var targetIndex = pinnedAppKeys.FindIndex(x => string.Equals(x, targetKey, StringComparison.OrdinalIgnoreCase));

		if (dragIndex < 0 || targetIndex < 0)
		{
			activeDragPinnedKey = null;
			return;
		}

		var draggedItem = pinnedAppKeys[dragIndex];
		pinnedAppKeys.RemoveAt(dragIndex);

		if (dragIndex < targetIndex)
			targetIndex--;

		pinnedAppKeys.Insert(targetIndex, draggedItem);

		activeDragPinnedKey = null;
		await SavePinnedAppsAsync();
		StateHasChanged();
	}

	private void HandlePinnedDragEnd(DragEventArgs _)
	{
		activeDragPinnedKey = null;
	}

