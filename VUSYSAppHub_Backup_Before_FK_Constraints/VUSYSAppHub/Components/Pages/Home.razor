	public async ValueTask DisposeAsync()
	{
		_isDisposed = true;

		try
		{
			_statusMonitorCts?.Cancel();
		}
		catch
		{
		}

		try
		{
			if (_statusMonitorTask is not null)
			{
				await _statusMonitorTask;
			}
		}
		catch
		{
		}

		try
		{
			_statusMonitorCts?.Dispose();
		}
		catch
		{
		}

		try
		{
			if (scrollListenerRegistered)
			{
				await JS.InvokeVoidAsync("appHubScroll.unregisterScrollListener");
			}
		}
		catch
		{
		}

		try
		{
			if (hotkeysRegistered)
			{
				await JS.InvokeVoidAsync("appHubHome.unregisterHotkeys");
			}
		}
		catch
		{
		}

		try
		{
			_statusHttpClient.Dispose();
		}
		catch
		{
		}

		dotNetRef?.Dispose();
	}

	private IEnumerable<PortalApp> FilterItems(IEnumerable<PortalApp> source, bool includeOtherLinksWhenEnvironmentFiltered)
	{
		var items = source ?? Enumerable.Empty<PortalApp>();

		items = items.Where(x => x.IsActive);

		if (!string.Equals(SelectedProductGroup, "All", StringComparison.OrdinalIgnoreCase))
		{
			items = items.Where(x => string.Equals(GetDisplayGroup(x), SelectedProductGroup, StringComparison.OrdinalIgnoreCase));
		}

		if (!string.Equals(SelectedEnvironment, "All", StringComparison.OrdinalIgnoreCase))
		{
			if (includeOtherLinksWhenEnvironmentFiltered)
			{
				items = items.Where(x =>
					IsOtherLink(x) ||
					string.Equals(GetDisplayEnvironment(x), SelectedEnvironment, StringComparison.OrdinalIgnoreCase));
			}
			else
			{
				items = items.Where(x => string.Equals(GetDisplayEnvironment(x), SelectedEnvironment, StringComparison.OrdinalIgnoreCase));
			}
		}

		if (!string.IsNullOrWhiteSpace(SearchText))
		{
			var term = SearchText.Trim();

			items = items.Where(app =>
				(!string.IsNullOrWhiteSpace(app.Name) && app.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(GetDisplayGroup(app)) && GetDisplayGroup(app).Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(GetDisplayEnvironment(app)) && GetDisplayEnvironment(app).Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(app.Description) && app.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
		}

		return items;
	}

	private IEnumerable<PortalApp> FilterOtherLinks()
	{
		var items = otherLinks ?? Enumerable.Empty<PortalApp>();
		items = items.Where(x => x.IsActive);
		if (!string.Equals(SelectedProductGroup, "All", StringComparison.OrdinalIgnoreCase) &&
			!string.Equals(SelectedProductGroup, "Other Links", StringComparison.OrdinalIgnoreCase))
		{
			return Enumerable.Empty<PortalApp>();
		}

		if (!string.Equals(SelectedEnvironment, "All", StringComparison.OrdinalIgnoreCase))
		{
			return Enumerable.Empty<PortalApp>();
		}

		if (!string.IsNullOrWhiteSpace(SearchText))
		{
			var term = SearchText.Trim();

			items = items.Where(link =>
				(!string.IsNullOrWhiteSpace(link.Name) && link.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(GetDisplayGroup(link)) && GetDisplayGroup(link).Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(GetDisplayEnvironment(link)) && GetDisplayEnvironment(link).Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(link.Description) && link.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
		}

		return items;
	}

	private bool IsMatchByDropdowns(PortalApp app)
	{
		var productGroupMatched =
			string.Equals(SelectedProductGroup, "All", StringComparison.OrdinalIgnoreCase) ||
			string.Equals(GetDisplayGroup(app), SelectedProductGroup, StringComparison.OrdinalIgnoreCase);

		var environmentMatched =
			string.Equals(SelectedEnvironment, "All", StringComparison.OrdinalIgnoreCase) ||
			(!IsOtherLink(app) && string.Equals(GetDisplayEnvironment(app), SelectedEnvironment, StringComparison.OrdinalIgnoreCase));

		if (IsOtherLink(app) && !string.Equals(SelectedEnvironment, "All", StringComparison.OrdinalIgnoreCase))
		{
			environmentMatched = false;
		}

		return productGroupMatched && environmentMatched;
	}

	private List<string> LoadProductGroups()
	{
		var groups = AppHubHomeHelper.LoadApplicationNamesFromJson(Env) ?? new List<string>();

		if (!groups.Contains("All", StringComparer.OrdinalIgnoreCase))
		{
			groups.Insert(0, "All");
		}

		if (!groups.Contains("Other Links", StringComparer.OrdinalIgnoreCase))
		{
			groups.Add("Other Links");
		}

		return groups
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.OrderBy(x => string.Equals(x, "All", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
			.ThenBy(x => x)
			.ToList();
	}

	private bool IsOtherLink(PortalApp app)
	{
		return string.Equals(GetDisplayGroup(app), "Other Links", StringComparison.OrdinalIgnoreCase);
	}

	private string GetDisplayGroup(PortalApp app)
	{
		return string.IsNullOrWhiteSpace(app?.ProductGroup) ? "Other Links" : app.ProductGroup;
	}

	private string GetDisplayEnvironment(PortalApp app)
	{
		if (IsOtherLink(app))
			return "Reference";

		return string.IsNullOrWhiteSpace(app?.Environment) ? "General" : app.Environment;
	}

	private string GetSuggestionMeta(PortalApp app)
