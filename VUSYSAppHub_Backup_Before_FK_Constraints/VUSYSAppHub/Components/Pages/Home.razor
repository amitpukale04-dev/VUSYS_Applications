	private IEnumerable<PortalApp> GetSearchSuggestions()
	{
		if (string.IsNullOrWhiteSpace(SearchText))
			return Enumerable.Empty<PortalApp>();

		var term = SearchText.Trim();

		return AllItems
			.Where(app =>
				app.IsActive &&
				IsMatchByDropdowns(app) &&
				(
					(!string.IsNullOrWhiteSpace(app.Name) && app.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
					(!string.IsNullOrWhiteSpace(app.ProductGroup) && app.ProductGroup.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
					(!string.IsNullOrWhiteSpace(app.Environment) && app.Environment.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
					(!string.IsNullOrWhiteSpace(app.Description) && app.Description.Contains(term, StringComparison.OrdinalIgnoreCase))
				))
			.OrderBy(app => !app.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
			.ThenBy(app => app.Name)
			.ThenBy(app => app.ProductGroup)
			.ThenBy(app => app.Environment)
			.Take(MaxSuggestions);
	}

	private IEnumerable<PortalApp> GetLauncherResults()
	{
		IEnumerable<PortalApp> source = AllItems.Where(x => x.IsActive);

		if (!string.IsNullOrWhiteSpace(LauncherSearchText))
		{
			var term = LauncherSearchText.Trim();

			source = source.Where(app =>
				(!string.IsNullOrWhiteSpace(app.Name) && app.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(app.ProductGroup) && app.ProductGroup.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(app.Environment) && app.Environment.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
				(!string.IsNullOrWhiteSpace(app.Description) && app.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
		}
		else
		{
			source = source
				.OrderByDescending(x => GetLaunchCount(x))
				.ThenByDescending(x => IsPinned(x))
				.ThenBy(x => x.ProductGroup)
				.ThenBy(x => x.SortOrder)
				.ThenBy(x => x.Name);
		}

		return source
			.OrderByDescending(x => GetLaunchCount(x))
			.ThenByDescending(x => IsPinned(x))
			.ThenBy(x => GetDisplayGroup(x))
			.ThenBy(x => AppHubHomeHelper.GetEnvironmentOrder(NormalizeEnvironmentForSorting(x.Environment)))
			.ThenBy(x => x.SortOrder)
			.ThenBy(x => x.Name)
			.Take(MaxLauncherResults);
	}

