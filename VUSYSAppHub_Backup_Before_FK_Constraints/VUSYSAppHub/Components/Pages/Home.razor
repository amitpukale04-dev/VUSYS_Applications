	private async Task TrackAppLaunchAsync(PortalApp app)
	{
		var key = GetAppUniqueKey(app);

		if (appLaunchCounts.ContainsKey(key))
			appLaunchCounts[key]++;
		else
			appLaunchCounts[key] = 1;

		await SaveAppLaunchAnalyticsAsync();
		await InvokeAsync(StateHasChanged);
	}

	private int GetLaunchCount(PortalApp app)
	{
		var key = GetAppUniqueKey(app);
		return appLaunchCounts.TryGetValue(key, out var count) ? count : 0;
	}

	private async Task LoadAppLaunchAnalyticsAsync()
	{
		try
		{
			var json = await JS.InvokeAsync<string>("localStorage.getItem", AppLaunchAnalyticsStorageKey);

			if (string.IsNullOrWhiteSpace(json))
			{
				appLaunchCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
				return;
			}

			appLaunchCounts = JsonSerializer.Deserialize<Dictionary<string, int>>(json)
							 ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

			appLaunchCounts = new Dictionary<string, int>(appLaunchCounts, StringComparer.OrdinalIgnoreCase);
		}
		catch
		{
			appLaunchCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
		}
	}

	private async Task SaveAppLaunchAnalyticsAsync()
	{
		try
		{
			var json = JsonSerializer.Serialize(appLaunchCounts);
			await JS.InvokeVoidAsync("localStorage.setItem", AppLaunchAnalyticsStorageKey, json);
		}
		catch
		{
		}
	}

	private string GetAppStatus(PortalApp app)
	{
		if (app == null)
			return "Live";

		if (IsOtherLink(app))
			return "Live";

		var key = GetAppUniqueKey(app);
		if (runtimeAppStatuses.TryGetValue(key, out var runtimeStatus) &&
			!string.IsNullOrWhiteSpace(runtimeStatus))
		{
			return NormalizeStatus(runtimeStatus);
		}

		if (!string.IsNullOrWhiteSpace(app.Status))
			return NormalizeStatus(app.Status);

		if (ReadBoolProperty(app, "IsMaintenance"))
			return "Maintenance";

		if (ReadBoolProperty(app, "IsDown"))
			return "Down";

		if (ReadBoolProperty(app, "IsLive"))
			return "Live";

		if (!app.IsActive)
			return "Down";

		var description = app.Description ?? string.Empty;

		if (description.Contains("maintenance", StringComparison.OrdinalIgnoreCase))
			return "Maintenance";

		if (description.Contains("down", StringComparison.OrdinalIgnoreCase) ||
			description.Contains("offline", StringComparison.OrdinalIgnoreCase))
			return "Down";

		return "Live";
	}

	private string GetAppStatusCssClass(PortalApp app)
	{
		var status = GetAppStatus(app);

		return status switch
		{
			"Down" => "status-down",
			"Maintenance" => "status-maintenance",
			_ => "status-live"
		};
	}

	private string GetAppStatusIcon(PortalApp app)
	{
		var status = GetAppStatus(app);

		return status switch
		{
			"Down" => "bi bi-x-octagon-fill",
			"Maintenance" => "bi bi-wrench-adjustable-circle-fill",
			_ => "bi bi-check-circle-fill"
		};
	}

	private static string NormalizeStatus(string? status)
	{
		if (string.IsNullOrWhiteSpace(status))
			return "Live";

		var value = status.Trim();

		if (value.Equals("down", StringComparison.OrdinalIgnoreCase) ||
			value.Equals("offline", StringComparison.OrdinalIgnoreCase) ||
			value.Equals("critical", StringComparison.OrdinalIgnoreCase))
			return "Down";

		if (value.Equals("maintenance", StringComparison.OrdinalIgnoreCase) ||
			value.Equals("maint", StringComparison.OrdinalIgnoreCase) ||
			value.Equals("warning", StringComparison.OrdinalIgnoreCase))
			return "Maintenance";

		return "Live";
	}

	private static string? ReadStringProperty(object obj, string propertyName)
	{
		var prop = obj.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
		if (prop is null)
			return null;

		var value = prop.GetValue(obj);
		return value?.ToString();
	}

	private static bool ReadBoolProperty(object obj, string propertyName)
	{
		var prop = obj.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
		if (prop is null)
			return false;

		var value = prop.GetValue(obj);

		if (value is bool boolValue)
			return boolValue;

		if (value is string str && bool.TryParse(str, out var parsed))
			return parsed;

		return false;
	}

