							</span>
							<div>
								<h4 class="application-section-title">Other Links</h4>
								<div class="application-section-subtitle">
									Reference links, documentation, and useful resources
								</div>
							</div>
						</div>

						<div class="application-section-count">
							Total: @FilteredOtherLinks.Count() link(s)
						</div>
					</div>
				</div>

				<div class="application-section-content @(isOtherLinksExpanded ? "expanded" : "collapsed")">
					<div class="card-body p-4">
						@if (FilteredOtherLinks.Any())
						{
							<div class="row g-4">
								<div class="col-12">
									<div class="environment-column other-links-column">
										<div class="environment-column-header other-links-column-header">
											<div><i class="bi bi-link-45deg me-2"></i>Links</div>
											<span class="environment-column-count">@FilteredOtherLinks.Count()</span>
										</div>

										<div class="environment-column-body">
											<ul class="app-link-list">
												@foreach (var link in FilteredOtherLinks.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
												{
													<li class="app-link-item other-link-item">
														<div class="app-link-top">
															<div class="app-link-left">
																<div class="app-link-title-row no-drag">
																	<div class="app-link-title-content">
																		<div class="app-link-name">
																			<i class="@GetItemIconCss(link) me-1"></i>@link.Name
																		</div>

																		@if (!string.IsNullOrWhiteSpace(link.Description))
																		{
																			<div class="other-link-description">
																				@link.Description
																			</div>
																		}

																		<div class="app-link-meta-row">
																			<div class="pinned-product-name">@GetDisplayGroup(link)</div>
																			<span class="app-status-badge @GetAppStatusCssClass(link)">
																				<i class="@GetAppStatusIcon(link) me-1"></i>@GetAppStatus(link)
																			</span>
																		</div>
																	</div>
																</div>
															</div>

															<div class="app-action-group">
																<button type="button"
																		class="btn btn-sm @(IsPinned(link) ? "btn-secondary" : "btn-outline-secondary") app-pin-link"
																		title="Pin link"
																		@onclick="() => TogglePinnedAppAsync(link)">
																	<i class="bi @(IsPinned(link) ? "bi-pin-angle-fill" : "bi-pin-angle") me-1"></i>
																	@(IsPinned(link) ? "Pinned" : "Pin")
																</button>

																<button type="button"
																		class="btn btn-sm btn-outline-info app-open-link"
																		@onclick="() => OpenAppAsync(link)">
																	<i class="bi @(link.OpenInNewTab ? "bi-box-arrow-up-right" : "bi-arrow-right-circle") me-1"></i>Open
																</button>
															</div>
														</div>
													</li>
												}
											</ul>
										</div>
									</div>
								</div>
							</div>
						}
						else
						{
							<div class="no-environment-data">
								<i class="bi bi-link-45deg me-2"></i>No Other Links found
							</div>
						}
					</div>
				</div>
			</div>
		}

		@if (!GroupedApplicationSections.Any() && !FilteredOtherLinks.Any())
		{
			<div class="card border-0 shadow-sm no-data-card">
				<div class="card-body text-center py-5">
					<div class="no-data-icon mb-3">
						<i class="bi bi-grid"></i>
					</div>
					<h4 class="mb-2">No applications or links found</h4>
					<p class="mb-0 text-body-secondary">Try changing the search text or dropdown filters.</p>
				</div>
			</div>
		}
	</div>

	<button type="button"
			class="scroll-to-top-btn @(showScrollToTop ? "show" : "")"
			title="Scroll to top"
			aria-label="Scroll to top"
			@onclick="ScrollToTopAsync">
		<i class="bi bi-chevron-up"></i>
	</button>

	@if (showLauncher)
	{
		<div class="launcher-overlay" @onclick="CloseLauncher">
			<div class="launcher-modal shadow-lg" @onclick:stopPropagation="true">
				<div class="launcher-header">
					<div class="launcher-search-wrap">
						<i class="bi bi-search launcher-search-icon"></i>
						<input id="launcherSearchInput"
							   type="text"
							   class="form-control launcher-search-input"
							   placeholder="Search apps, links, environments, descriptions..."
							   @bind="LauncherSearchText"
