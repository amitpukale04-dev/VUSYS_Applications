	private string GetPinnedGroupName(PortalApp app)
	{
		if (IsOtherLink(app))
			return "Other Links";

		return GetDisplayEnvironment(app);
	}

	private int GetPinnedGroupOrder(string groupName)
	{
		if (string.Equals(groupName, "Development", StringComparison.OrdinalIgnoreCase))
			return 1;

		if (string.Equals(groupName, "Staging", StringComparison.OrdinalIgnoreCase))
			return 2;

		if (string.Equals(groupName, "Production", StringComparison.OrdinalIgnoreCase))
			return 3;

		if (string.Equals(groupName, "Other Links", StringComparison.OrdinalIgnoreCase))
			return 4;

		return 99;
	}

