	}
</div>

<script>
	window.appHubHome = window.appHubHome || (function () {
		let hotkeyHandler = null;

		return {
			registerHotkeys: function (dotNetRef) {
				if (hotkeyHandler) return;

				hotkeyHandler = function (event) {
					const isCtrlOrMeta = event.ctrlKey || event.metaKey;

					if (isCtrlOrMeta && event.key.toLowerCase() === "k") {
						event.preventDefault();
						dotNetRef.invokeMethodAsync("OpenLauncherFromHotkey");
						return;
					}

					if (event.key === "Escape") {
						dotNetRef.invokeMethodAsync("CloseLauncherFromHotkey");
					}
				};

				document.addEventListener("keydown", hotkeyHandler);
			},

			unregisterHotkeys: function () {
				if (!hotkeyHandler) return;
				document.removeEventListener("keydown", hotkeyHandler);
				hotkeyHandler = null;
			},

			focusElementById: function (elementId) {
				const el = document.getElementById(elementId);
				if (!el) return;

				window.requestAnimationFrame(() => {
					el.focus();
					if (el.select) {
						el.select();
					}
				});
			},

			openApp: function (url, openInNewTab) {
				if (!url) return;

				if (openInNewTab) {
					window.open(url, "_blank", "noopener,noreferrer");
				} else {
					window.location.href = url;
				}
			}
		};
	})();
</script>

@code {
	private const string PinnedAppsStorageKey = "VUSYSAppHub_PinnedApps";
	private const string AppLaunchAnalyticsStorageKey = "VUSYSAppHub_AppLaunchAnalytics";
	private const string OtherLinksSectionKey = "__OTHER_LINKS__";
	private const int MaxSuggestions = 8;
	private const int MaxLauncherResults = 20;
	private const int MaxMostUsedApps = 8;
	private const int StatusRefreshIntervalSeconds = 10;
	private static readonly TimeSpan StatusRequestTimeout = TimeSpan.FromSeconds(5);

	private bool isDarkMode = false;
	private bool showScrollToTop = false;
	private bool showLauncher = false;

	private string searchText = string.Empty;
	private string launcherSearchText = string.Empty;
	private string selectedProductGroup = "All";
	private string selectedEnvironment = "All";
	private string? activeDragPinnedKey;

	private bool isSearchFocused = false;
	private bool showSearchSuggestions = false;

	private List<string> productGroups = new() { "All" };
	private IReadOnlyList<string> environments = Array.Empty<string>();
	private IReadOnlyList<PortalApp> apps = new List<PortalApp>();
	private IReadOnlyList<PortalApp> otherLinks = new List<PortalApp>();
	private List<string> pinnedAppKeys = new();
	private Dictionary<string, int> appLaunchCounts = new(StringComparer.OrdinalIgnoreCase);
	private readonly Dictionary<string, string> runtimeAppStatuses = new(StringComparer.OrdinalIgnoreCase);

	private readonly Dictionary<string, bool> expandedSections = new(StringComparer.OrdinalIgnoreCase);

	private DotNetObjectReference<Home>? dotNetRef;
	private bool scrollListenerRegistered = false;
	private bool hotkeysRegistered = false;

	private readonly HttpClient _statusHttpClient = new(new HttpClientHandler
	{
		AllowAutoRedirect = false
	})
	{
		Timeout = StatusRequestTimeout
	};

	private CancellationTokenSource? _statusMonitorCts;
	private Task? _statusMonitorTask;
	private bool _isStatusMonitorStarted = false;
	private bool _isDisposed = false;

	private string SearchText
	{
		get => searchText;
		set
		{
			var newValue = value ?? string.Empty;

			if (searchText == newValue)
				return;

			searchText = newValue;
			HandleFilterChange();
			UpdateSuggestionVisibility();
		}
	}

	private string LauncherSearchText
	{
		get => launcherSearchText;
		set
		{
			launcherSearchText = value ?? string.Empty;
		}
	}

	private string SelectedProductGroup
	{
		get => selectedProductGroup;
		set
		{
			if (selectedProductGroup == value)
				return;

			selectedProductGroup = string.IsNullOrWhiteSpace(value) ? "All" : value;
			HandleFilterChange();
			UpdateSuggestionVisibility();
		}
	}

	private string SelectedEnvironment
	{
		get => selectedEnvironment;
		set
		{
			if (selectedEnvironment == value)
				return;

			selectedEnvironment = string.IsNullOrWhiteSpace(value) ? "All" : value;
			HandleFilterChange();
			UpdateSuggestionVisibility();
		}
	}

	private bool HasActiveFilters =>
		!string.IsNullOrWhiteSpace(SearchText) ||
		!string.Equals(SelectedProductGroup, "All", StringComparison.OrdinalIgnoreCase) ||
		!string.Equals(SelectedEnvironment, "All", StringComparison.OrdinalIgnoreCase);

	private IEnumerable<PortalApp> FilteredApps =>
		FilterItems(apps, includeOtherLinksWhenEnvironmentFiltered: false);

	private IEnumerable<PortalApp> FilteredOtherLinks =>
		FilterOtherLinks();

	private IEnumerable<PortalApp> FilteredItems =>
		FilteredApps.Concat(FilteredOtherLinks);

	private IEnumerable<ApplicationSectionGroup> GroupedApplicationSections =>
		AppHubHomeHelper.GroupedApplicationSections(FilteredApps);

	private List<PortalApp> SearchSuggestions =>
		GetSearchSuggestions().ToList();

	private bool ShowSearchSuggestions =>
		showSearchSuggestions && SearchSuggestions.Any();

	private List<PortalApp> PinnedApps =>
		pinnedAppKeys
			.Select(FindAppByKey)
			.Where(app => app is not null)
			.Select(app => app!)
			.ToList();

	private IEnumerable<PinnedEnvironmentGroup> PinnedGroupedSections =>
		PinnedApps
			.GroupBy(x => GetPinnedGroupName(x))
			.OrderBy(g => GetPinnedGroupOrder(g.Key))
			.Select(g => new PinnedEnvironmentGroup
			{
				Environment = g.Key,
				Apps = g.ToList()
			});

	private List<PortalApp> MostUsedApps =>
		AllItems
			.Where(x => appLaunchCounts.ContainsKey(GetAppUniqueKey(x)))
			.OrderByDescending(x => GetLaunchCount(x))
			.ThenBy(x => x.Name)
			.Take(MaxMostUsedApps)
			.ToList();

	private List<PortalApp> LauncherResults =>
		GetLauncherResults().ToList();

	private IEnumerable<PortalApp> AllItems =>
		apps.Concat(otherLinks);

	private bool ShouldShowOtherLinksSection =>
		otherLinks.Any() &&
		(
			FilteredOtherLinks.Any() ||
			(!HasActiveFilters && SelectedEnvironment.Equals("All", StringComparison.OrdinalIgnoreCase))
		);

	protected override Task OnInitializedAsync()
	{
		environments = AppHubHomeHelper.Environments;
		productGroups = LoadProductGroups();
		apps = AppHubHomeHelper.LoadPortalApplicationsFromJson(Env, PortalAppService);
		otherLinks = AppHubHomeHelper.LoadOtherLinksFromJson(Env);

		InitializeExpandedSectionsCollapsed();
		return Task.CompletedTask;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			isDarkMode = await JS.InvokeAsync<bool>("themeManager.getCurrentThemeIsDark");
			await LoadPinnedAppsAsync();
			await LoadAppLaunchAnalyticsAsync();

			dotNetRef = DotNetObjectReference.Create(this);
			await JS.InvokeVoidAsync("appHubScroll.registerScrollListener", dotNetRef);
			scrollListenerRegistered = true;

			await JS.InvokeVoidAsync("appHubHome.registerHotkeys", dotNetRef);
			hotkeysRegistered = true;

			await RefreshAllAppStatusesAsync();
			StartStatusMonitor();

			StateHasChanged();
		}

		if (showLauncher)
		{
			await JS.InvokeVoidAsync("appHubHome.focusElementById", "launcherSearchInput");
		}
	}

	private void StartStatusMonitor()
	{
		if (_isStatusMonitorStarted || _isDisposed)
			return;

		_isStatusMonitorStarted = true;
		_statusMonitorCts = new CancellationTokenSource();
		_statusMonitorTask = RunStatusMonitorAsync(_statusMonitorCts.Token);
	}

	private async Task RunStatusMonitorAsync(CancellationToken cancellationToken)
	{
		try
		{
			using var timer = new PeriodicTimer(TimeSpan.FromSeconds(StatusRefreshIntervalSeconds));

			while (await timer.WaitForNextTickAsync(cancellationToken))
			{
				await RefreshAllAppStatusesAsync(cancellationToken);
			}
		}
		catch (OperationCanceledException)
		{
		}
		catch
		{
		}
	}

	private async Task RefreshAllAppStatusesAsync(CancellationToken cancellationToken = default)
	{
		var statusChanged = false;

		foreach (var app in AllItems.Where(CanCheckAppHealth))
		{
			var newStatus = await CheckAppHealthStatusAsync(app, cancellationToken);
			var key = GetAppUniqueKey(app);

			if (!runtimeAppStatuses.TryGetValue(key, out var existingStatus) ||
				!string.Equals(existingStatus, newStatus, StringComparison.OrdinalIgnoreCase))
			{
				runtimeAppStatuses[key] = newStatus;
				statusChanged = true;
			}
		}

		if (statusChanged && !_isDisposed)
		{
			await InvokeAsync(StateHasChanged);
		}
	}

	private async Task RefreshSingleAppStatusAsync(PortalApp app, bool shouldTriggerUiRefresh = true, CancellationToken cancellationToken = default)
	{
		if (!CanCheckAppHealth(app))
			return;

		var key = GetAppUniqueKey(app);
		var newStatus = await CheckAppHealthStatusAsync(app, cancellationToken);

		if (!runtimeAppStatuses.TryGetValue(key, out var existingStatus) ||
			!string.Equals(existingStatus, newStatus, StringComparison.OrdinalIgnoreCase))
		{
			runtimeAppStatuses[key] = newStatus;

			if (shouldTriggerUiRefresh && !_isDisposed)
			{
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	private bool CanCheckAppHealth(PortalApp app)
	{
		if (app == null)
			return false;

		if (IsOtherLink(app))
			return false;

		var healthCheckUrl = GetHealthCheckUrl(app);
		return Uri.TryCreate(healthCheckUrl, UriKind.Absolute, out var uri)
						&& (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
	}

	private string GetHealthCheckUrl(PortalApp app)
	{
		var explicitHealthCheckUrl =
			ReadStringProperty(app, "HealthCheckUrl") ??
			ReadStringProperty(app, "HealthUrl") ??
			ReadStringProperty(app, "StatusCheckUrl");

		var rawUrl = string.IsNullOrWhiteSpace(explicitHealthCheckUrl) ? app.Url : explicitHealthCheckUrl;

		if (string.IsNullOrWhiteSpace(rawUrl))
			return string.Empty;

		if (!Uri.TryCreate(rawUrl, UriKind.Absolute, out var absoluteUri))
			return rawUrl;

		var builder = new UriBuilder(absoluteUri)
		{
			Query = string.Empty,
			Fragment = string.Empty
		};

		return builder.Uri.ToString();
	}

	private async Task<string> CheckAppHealthStatusAsync(PortalApp app, CancellationToken cancellationToken = default)
	{
		try
		{
			var healthCheckUrl = GetHealthCheckUrl(app);

			if (string.IsNullOrWhiteSpace(healthCheckUrl))
				return "Maintenance";

			using var request = new HttpRequestMessage(HttpMethod.Get, healthCheckUrl);
			using var response = await _statusHttpClient.SendAsync(
				request,
				HttpCompletionOption.ResponseHeadersRead,
				cancellationToken);

			var statusCode = (int)response.StatusCode;

			if (statusCode >= 200 && statusCode < 300)
				return "Live";

			if (statusCode >= 300 && statusCode < 500)
				return "Maintenance";

			return "Down";
		}
		catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
		{
			return "Down";
		}
		catch (HttpRequestException)
		{
			return "Down";
		}
		catch
		{
			return "Down";
		}
	}

	private async Task ToggleThemeAsync()
	{
		isDarkMode = await JS.InvokeAsync<bool>("themeManager.toggleTheme");
	}

	private void NavigateToDatabaseObjectGeneration()
	{
		Navigation.NavigateTo("/database-object-generation");
	}

	private void NavigateToRealTimeIISMonitoringDashboard()
	{
		Navigation.NavigateTo("/iis-monitoring-dashboard");
	}

	private void NavigateToUpdateDeploymentVersionNo()
	{
		Navigation.NavigateTo("/update-app-deployment-version");
	}

	private void InitializeExpandedSectionsCollapsed()
	{
		expandedSections.Clear();

		foreach (var groupName in apps
			.Where(x => !string.IsNullOrWhiteSpace(x.ProductGroup))
			.Select(x => x.ProductGroup)
			.Distinct(StringComparer.OrdinalIgnoreCase))
		{
			expandedSections[groupName] = false;
		}

		expandedSections[OtherLinksSectionKey] = false;
	}

	private bool IsSectionExpanded(string applicationName)
	{
		if (string.IsNullOrWhiteSpace(applicationName))
			return false;

		if (expandedSections.TryGetValue(applicationName, out var isExpanded))
			return isExpanded;

		expandedSections[applicationName] = false;
		return false;
	}

	private void ToggleSection(string applicationName)
	{
		if (string.IsNullOrWhiteSpace(applicationName))
			return;

		if (expandedSections.ContainsKey(applicationName))
			expandedSections[applicationName] = !expandedSections[applicationName];
		else
			expandedSections[applicationName] = true;
	}

	private void HandleSectionHeaderKeyDown(KeyboardEventArgs e, string applicationName)
	{
		if (e.Key is "Enter" or " ")
		{
			ToggleSection(applicationName);
		}
	}

	private void HandleFilterChange()
	{
		if (HasActiveFilters)
			ExpandMatchingSections();
		else
			CollapseAllSections();
	}

	private void ExpandMatchingSections()
	{
		var matchingGroups = FilteredApps
			.Where(x => !string.IsNullOrWhiteSpace(x.ProductGroup))
			.Select(x => x.ProductGroup)
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.ToHashSet(StringComparer.OrdinalIgnoreCase);

		foreach (var key in expandedSections.Keys.ToList())
		{
			expandedSections[key] = matchingGroups.Contains(key);
		}

		foreach (var key in matchingGroups)
		{
			if (!expandedSections.ContainsKey(key))
				expandedSections[key] = true;
		}

		if (FilteredOtherLinks.Any())
		{
			expandedSections[OtherLinksSectionKey] = true;
		}
	}

	private void CollapseAllSections()
	{
		foreach (var key in expandedSections.Keys.ToList())
		{
			expandedSections[key] = false;
		}
	}

	private void ClearAllFilters()
	{
		searchText = string.Empty;
		selectedProductGroup = "All";
		selectedEnvironment = "All";
		isSearchFocused = false;
		showSearchSuggestions = false;
		CollapseAllSections();
	}

	private async Task TogglePinnedAppAsync(PortalApp app)
	{
		var key = GetAppUniqueKey(app);

		if (pinnedAppKeys.Contains(key, StringComparer.OrdinalIgnoreCase))
			pinnedAppKeys.RemoveAll(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase));
		else
			pinnedAppKeys.Add(key);

		await SavePinnedAppsAsync();
		StateHasChanged();
	}

	private bool IsPinned(PortalApp app)
	{
		return pinnedAppKeys.Contains(GetAppUniqueKey(app), StringComparer.OrdinalIgnoreCase);
	}

	private string GetAppUniqueKey(PortalApp app)
	{
		return $"{GetDisplayGroup(app)}||{GetDisplayEnvironment(app)}||{app.Name}||{app.Url}";
	}

	private PortalApp? FindAppByKey(string key)
	{
		return AllItems.FirstOrDefault(x => string.Equals(GetAppUniqueKey(x), key, StringComparison.OrdinalIgnoreCase));
	}

	private async Task LoadPinnedAppsAsync()
	{
		try
		{
			var json = await JS.InvokeAsync<string>("localStorage.getItem", PinnedAppsStorageKey);

			if (string.IsNullOrWhiteSpace(json))
			{
				pinnedAppKeys = new List<string>();
				return;
			}

			pinnedAppKeys = JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
		}
		catch
		{
			pinnedAppKeys = new List<string>();
		}
	}

	private async Task SavePinnedAppsAsync()
	{
		try
		{
			var distinctOrderedKeys = new List<string>();
			var uniqueSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

			foreach (var key in pinnedAppKeys)
			{
				if (uniqueSet.Add(key))
					distinctOrderedKeys.Add(key);
			}

			pinnedAppKeys = distinctOrderedKeys;

			var json = JsonSerializer.Serialize(pinnedAppKeys);
			await JS.InvokeVoidAsync("localStorage.setItem", PinnedAppsStorageKey, json);
		}
		catch
		{
		}
	}

	private void HandlePinnedDragStart(DragEventArgs _, PortalApp app)
	{
		activeDragPinnedKey = GetAppUniqueKey(app);
	}

	private async Task HandlePinnedDrop(PortalApp targetApp)
	{
		if (string.IsNullOrWhiteSpace(activeDragPinnedKey))
			return;

		var targetKey = GetAppUniqueKey(targetApp);

		if (string.Equals(activeDragPinnedKey, targetKey, StringComparison.OrdinalIgnoreCase))
		{
			activeDragPinnedKey = null;
			return;
		}

		var dragIndex = pinnedAppKeys.FindIndex(x => string.Equals(x, activeDragPinnedKey, StringComparison.OrdinalIgnoreCase));
		var targetIndex = pinnedAppKeys.FindIndex(x => string.Equals(x, targetKey, StringComparison.OrdinalIgnoreCase));

		if (dragIndex < 0 || targetIndex < 0)
		{
			activeDragPinnedKey = null;
			return;
		}

		var draggedItem = pinnedAppKeys[dragIndex];
		pinnedAppKeys.RemoveAt(dragIndex);

		if (dragIndex < targetIndex)
			targetIndex--;

		pinnedAppKeys.Insert(targetIndex, draggedItem);

		activeDragPinnedKey = null;
		await SavePinnedAppsAsync();
		StateHasChanged();
	}

	private void HandlePinnedDragEnd(DragEventArgs _)
	{
		activeDragPinnedKey = null;
	}

