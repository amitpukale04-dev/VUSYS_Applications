    private bool HasAnyDataScriptOperationSelected()
    {
        return dataScriptGenerateInsert || dataScriptGenerateUpdate || dataScriptGenerateDelete;
    }

    private List<DbObjectItem> BuildItemsForGeneration(List<DbObjectItem> selectedItems)
    {
        var resolvedDataScriptType = BuildResolvedDataScriptObjectType();

        return selectedItems
            .Select(item => new DbObjectItem
            {
                SchemaName = item.SchemaName,
                ObjectName = item.ObjectName,
                ObjectType = item.ObjectType.Equals("DataScript", StringComparison.OrdinalIgnoreCase)
                    ? resolvedDataScriptType
                    : item.ObjectType,
                IsSelected = item.IsSelected
            })
            .ToList();
    }

    private string BuildResolvedDataScriptObjectType()
    {
        var operations = new List<string>();

        if (dataScriptGenerateInsert)
            operations.Add("Insert");

        if (dataScriptGenerateUpdate)
            operations.Add("Update");

        if (dataScriptGenerateDelete)
            operations.Add("Delete");

        if (operations.Count == 0)
            return "DataScript";

        return $"DataScript|{string.Join("|", operations)}";
    }

    private async Task GenerateScriptAsync()
    {
        try
        {
            scriptOptions.IncludeInsert = dataScriptGenerateInsert;
            scriptOptions.IncludeUpdate = dataScriptGenerateUpdate;
            scriptOptions.IncludeDelete = dataScriptGenerateDelete;

            var selectedItems = GetSelectedItems();
            if (!selectedItems.Any())
            {
                previewScript = "-- Please select at least one object.";
                connectionMessage = previewScript;
                isConnected = false;
                await ShowConnectionAlertAsync();
                return;
            }

            var selectedDataScriptItems = selectedItems
                .Where(x => x.ObjectType.Equals("DataScript", StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (selectedDataScriptItems.Count > 0 && !HasAnyDataScriptOperationSelected())
            {
                previewScript = "-- Please select at least one DataScript option: Insert, Update or Delete.";
                connectionMessage = previewScript;
                isConnected = false;
                await ShowConnectionAlertAsync();
                return;
            }

            isGenerating = true;
            connectionMessage = string.Empty;

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var itemsForGeneration = BuildItemsForGeneration(selectedItems);

            previewScript = await DatabaseObjectGeneratorService.GenerateScriptAsync(currentConfig, itemsForGeneration, scriptOptions);
            lastActionAt = DateTime.Now;

            var sqlBytes = Encoding.UTF8.GetBytes(previewScript);
            downloadFileName = $"DbObjects_{currentConfig.ApplicationName}_{currentConfig.EnvironmentName}_{DateTime.Now:yyyyMMdd_HHmmss}.sql";
            downloadHref = $"data:text/plain;base64,{Convert.ToBase64String(sqlBytes)}";

            using var memoryStream = new MemoryStream();
            using (var archive = new ZipArchive(memoryStream, ZipArchiveMode.Create, true))
            {
                var entry = archive.CreateEntry(downloadFileName, CompressionLevel.Fastest);
                await using var entryStream = entry.Open();
                await entryStream.WriteAsync(sqlBytes, 0, sqlBytes.Length);
            }

            zipDownloadFileName = $"DbObjects_{currentConfig.ApplicationName}_{currentConfig.EnvironmentName}_{DateTime.Now:yyyyMMdd_HHmmss}.zip";
            zipDownloadHref = $"data:application/zip;base64,{Convert.ToBase64String(memoryStream.ToArray())}";

            ScriptHistoryStore.Add(new ScriptHistoryEntry
            {
                GeneratedOn = DateTime.Now,
                ApplicationName = currentConfig.ApplicationName,
                EnvironmentName = currentConfig.EnvironmentName,
                ObjectCount = selectedItems.Count,
                FileName = downloadFileName,
                PreviewText = previewScript.Length > 500 ? previewScript[..500] : previewScript
            });

            historyEntries = ScriptHistoryStore.GetAll();
        }
        catch (Exception ex)
        {
            previewScript = $"-- Error: {ex.Message}";
            connectionMessage = ex.Message;
            isConnected = false;
            await ShowConnectionAlertAsync();
        }
        finally
        {
            isGenerating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearHistory()
    {
        ScriptHistoryStore.Clear();
        historyEntries = ScriptHistoryStore.GetAll();
    }

