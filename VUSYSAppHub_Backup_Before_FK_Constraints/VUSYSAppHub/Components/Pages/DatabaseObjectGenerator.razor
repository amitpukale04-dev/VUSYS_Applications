    private void ClearOtpInputs()
    {
        otpDigits = new string[6] { "", "", "", "", "", "" };
    }

    private async Task OnOtpInputAsync(int index, ChangeEventArgs e)
    {
        var input = Convert.ToString(e.Value)?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(input))
        {
            otpDigits[index] = string.Empty;
            return;
        }

        var digit = input.LastOrDefault(char.IsDigit);

        if (digit == default)
        {
            otpDigits[index] = string.Empty;
            return;
        }

        otpDigits[index] = digit.ToString();

        if (index < otpDigits.Length - 1)
        {
            await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{index + 1}");
        }
    }

    private async Task OnOtpPasteAsync(int startIndex, ClipboardEventArgs e)
    {
        try
        {
            otpPopupErrorMessage = string.Empty;

            var clipboardText = await JS.InvokeAsync<string>("appHubOtp.getClipboardText");
            if (string.IsNullOrWhiteSpace(clipboardText))
                return;

            var digitsOnly = new string(clipboardText.Where(char.IsDigit).ToArray());
            if (string.IsNullOrWhiteSpace(digitsOnly))
                return;

            var targetIndex = startIndex;

            for (int i = 0; i < digitsOnly.Length && targetIndex < otpDigits.Length; i++, targetIndex++)
            {
                otpDigits[targetIndex] = digitsOnly[i].ToString();
            }

            await InvokeAsync(StateHasChanged);

            var nextFocusIndex = Array.FindIndex(otpDigits, startIndex, value => string.IsNullOrWhiteSpace(value));
            if (nextFocusIndex >= 0)
            {
                await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{nextFocusIndex}");
            }
            else
            {
                await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{otpDigits.Length - 1}");
            }
        }
        catch (Exception ex)
        {
            otpPopupErrorMessage = ex.Message;
        }
    }

    private async Task OnOtpKeyDownAsync(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace")
        {
            if (string.IsNullOrWhiteSpace(otpDigits[index]))
            {
                if (index > 0)
                {
                    otpDigits[index - 1] = string.Empty;
                    await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{index - 1}");
                }
            }
            else
            {
                otpDigits[index] = string.Empty;
            }
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{index - 1}");
        }
        else if (e.Key == "ArrowRight" && index < otpDigits.Length - 1)
        {
            await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", $"db-otp-box-{index + 1}");
        }
    }

    private static string GenerateSixDigitOtp()
    {
        var otpNumber = RandomNumberGenerator.GetInt32(100000, 1000000);
        return otpNumber.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (scrollListenerRegistered)
                await JS.InvokeVoidAsync("appHubScroll.unregisterScrollListener");
        }
        catch
        {
        }

        try
        {
            alertCancellationTokenSource?.Cancel();
            alertCancellationTokenSource?.Dispose();
        }
        catch
        {
        }

        try
        {
            searchBlurCancellationTokenSource?.Cancel();
            searchBlurCancellationTokenSource?.Dispose();
        }
        catch
        {
        }

        try
        {
            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
        }
        catch
        {
        }

        dotNetRef?.Dispose();
    }
}