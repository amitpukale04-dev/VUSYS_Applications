@page "/database-object-generation"
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject IDatabaseObjectGeneratorService DatabaseObjectGeneratorService
@inject IScriptHistoryStore ScriptHistoryStore
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using System.IO.Compression
@using System.Security.Cryptography
@using System.Text
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using VUSYSAppHub.Contracts
@using VUSYSAppHub.DACHelper
@using VUSYSAppHub.Models

<PageTitle>Database Object Generation</PageTitle>

<div class="apphub-page @(isDarkMode ? "dark-mode" : "")" data-bs-theme="@(isDarkMode ? "dark" : "light")">
    <div class="container-fluid px-3 px-md-4 px-lg-5 py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 monitoring-page-header">
            <div>
                <h2 class="page-title mb-1">Database Object Generation</h2>
                <div class="page-note">Dedicated page to connect, browse objects, filter, preview and generate scripts by application and environment.</div>
            </div>

            <div class="monitoring-header-actions">
                <button type="button"
                        class="btn btn-back-dashboard d-inline-flex align-items-center gap-2"
                        @onclick="BackToHome">
                    <i class="bi bi-arrow-left-circle-fill"></i>
                    <span>Back to App Hub</span>
                </button>

                <button type="button"
                        class="btn btn-theme d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                        style="width: 56px; height: 56px; padding: 0;"
                        title="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        aria-label="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")"
                        @onclick="ToggleThemeAsync">
                    <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill") fs-4"></i>
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4 monitoring-dashboard-card">
            <div class="monitoring-dashboard-header">
                <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="monitoring-dashboard-icon">
                            <i class="bi bi-database-gear"></i>
                        </div>
                        <div>
                            <h4 class="monitoring-dashboard-title mb-1">Database Object Generation</h4>
                            <div class="monitoring-dashboard-subtitle">
                                Manage connection details, filters and script generation options across supported environments.
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-dashboard-right">
                        <div class="monitoring-refresh-pill @((isConnecting || isGenerating || isRefreshingDatabase || isPopupBusy) ? "refreshing" : "")">
                            <span class="monitoring-refresh-dot"></span>
                            <span>@GetActionStatusText()</span>
                        </div>

                        <div class="monitoring-last-refresh">
                            <i class="bi bi-clock-history me-1"></i>
                            @(lastActionAt.HasValue ? $"Last action: {lastActionAt.Value:dd-MMM-yyyy hh:mm:ss tt}" : "Last action: --")
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @if (showConnectionAlert && !string.IsNullOrWhiteSpace(connectionMessage))
                {
                    <div class="alert @(isConnected ? "alert-success" : "alert-danger") mb-4" role="alert">
                        <i class="bi @(isConnected ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                        @connectionMessage
                    </div>
                }

                <div class="database-section-title mb-3">
                    <div class="w-100">
                        <h3>Connection Section</h3>

                        <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <p class="mb-0">Select application and environment to connect.</p>

                                <div class="d-flex align-items-center gap-2">
                                    <button type="button"
                                            class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                            style="width: 42px; height: 42px; min-width: 42px; min-height: 42px; padding: 0;"
                                            title="Clear"
                                            aria-label="Clear"
                                            @onclick="ClearSelections"
                                            disabled="@(!CanClearSelections())">
                                        <i class="bi bi-x-circle"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-danger d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                            style="width: 42px; height: 42px; min-width: 42px; min-height: 42px; padding: 0;"
                                            title="Disconnect"
                                            aria-label="Disconnect"
                                            @onclick="DisconnectAsync"
                                            disabled="@(!CanDisconnect())">
                                        <i class="bi bi-plug"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                            style="width: 42px; height: 42px; min-width: 42px; min-height: 42px; padding: 0;"
                                            title="@(isConnecting ? "Connecting..." : "Connect")"
                                            aria-label="Connect"
                                            @onclick="OpenLoginPopupAsync"
                                            disabled="@(!CanConnect())">
                                        <i class="bi @(isConnecting ? "bi-arrow-repeat" : "bi-plug-fill")"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-success d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                            style="width: 42px; height: 42px; min-width: 42px; min-height: 42px; padding: 0;"
                                            title="@(isRefreshingDatabase ? "Refreshing Database..." : "Refresh Database")"
                                            aria-label="Refresh Database"
                                            @onclick="RefreshDatabaseAsync"
                                            disabled="@(!CanRefreshDatabase())">
                                        <i class="bi @(isRefreshingDatabase ? "bi-arrow-repeat" : "bi-arrow-clockwise")"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="database-connection-status @(GetConnectionStatusCss()) flex-shrink-0">
                                <i class="bi @(GetConnectionStatusIcon())"></i>
                                <span>@GetConnectionStatusText()</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Application</label>
                        <select class="form-select form-select-modern"
                                value="@selectedApplication"
                                @onchange="OnApplicationChanged"
                                disabled="@(isConnecting || isConnected || isRefreshingDatabase || showLoginPopup || showOtpPopup || isPopupBusy)">
                            <option value="">SELECT</option>
                            @foreach (var app in applicationList)
                            {
                                <option value="@app">@app</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Environment</label>
                        <select class="form-select form-select-modern"
                                value="@selectedEnvironment"
                                @onchange="OnEnvironmentChanged"
                                disabled="@(!CanSelectEnvironment())">
                            <option value="">SELECT</option>
                            @foreach (var env in environmentList)
                            {
                                <option value="@env">@env</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Database Type</label>
                        <input class="form-control form-select-modern" value="@currentConfig.DatabaseType" readonly />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Server Name</label>
                        <input class="form-control form-select-modern" value="@currentConfig.ServerName" readonly />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Database Name</label>
                        <input class="form-control form-select-modern" value="@currentConfig.DatabaseName" readonly />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Authentication Type</label>
                        <input class="form-control form-select-modern" value="@currentConfig.AuthenticationType" readonly />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">User Name</label>
                        <input class="form-control form-select-modern" value="@currentConfig.UserName" readonly />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="filter-label">Password</label>
                        <input class="form-control form-select-modern" value="@passwordMask" readonly />
                    </div>
                </div>

                <div class="monitoring-panel monitoring-panel-gradient mb-4">
                    <div class="monitoring-panel-header-gradient">
                        <div class="monitoring-panel-header-top">
                            <div class="monitoring-panel-title-group">
                                <div class="monitoring-dashboard-icon" style="width:48px;height:48px;font-size:1.15rem;">
                                    <i class="bi bi-funnel-fill"></i>
                                </div>
                                <div>
                                    <div class="monitoring-panel-title-light">Filters</div>
                                    <div class="monitoring-panel-subtitle-light">
                                        Object Type Filter and Schema Filter
                                    </div>
                                </div>
                            </div>

                            <div class="monitoring-panel-actions d-flex align-items-center gap-2">
                                <button type="button"
                                        class="database-btn-secondary"
                                        title="Clear Filters"
                                        aria-label="Clear Filters"
                                        @onclick="ClearFilters"
                                        disabled="@(!CanClearFilters())">
                                    <i class="bi bi-eraser"></i>
                                    <span>Clear Filters</span>
                                </button>

                                <button type="button"
                                        class="monitoring-panel-toggle-btn monitoring-panel-toggle-btn-gradient"
                                        @onclick="ToggleFiltersSection"
                                        title="@(isFiltersExpanded ? "Collapse Filters" : "Expand Filters")"
                                        aria-label="@(isFiltersExpanded ? "Collapse Filters" : "Expand Filters")">
                                    <i class="bi @(isFiltersExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-panel-content @(isFiltersExpanded ? "expanded" : "collapsed")">
                        <div class="monitoring-panel-body-soft p-4">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <label class="filter-label">Object Type Filter</label>
                                    <select class="form-select form-select-modern"
                                            value="@objectTypeFilter"
                                            @onchange="OnObjectTypeFilterChanged">
                                        <option value="All">All</option>
                                        <option value="Table">Tables</option>
                                        <option value="View">Views</option>
                                        <option value="Procedure">Procedures</option>
                                        <option value="Function">Functions</option>
                                        <option value="Index">Indexes</option>
                                        <option value="Trigger">Triggers</option>
                                        <option value="DataScript">DataScript</option>
                                    </select>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="filter-label">Schema Filter</label>
                                    <select class="form-select form-select-modern"
                                            value="@schemaFilter"
                                            @onchange="OnSchemaFilterChanged">
                                        <option value="All">All</option>
                                        @foreach (var schema in schemaList)
                                        {
                                            <option value="@schema">@schema</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="monitoring-panel monitoring-panel-gradient">
                    <div class="monitoring-panel-header-gradient">
                        <div class="monitoring-panel-header-top">
                            <div class="monitoring-panel-title-group">
                                <div class="monitoring-dashboard-icon" style="width:48px;height:48px;font-size:1.15rem;">
                                    <i class="bi bi-sliders"></i>
                                </div>
                                <div>
                                    <div class="monitoring-panel-title-light">Script Options</div>
                                    <div class="monitoring-panel-subtitle-light">
                                        Control generated script format and ordering
                                    </div>
                                </div>
                            </div>

                            <div class="monitoring-panel-actions d-flex align-items-center gap-2">
                                <button type="button"
                                        class="database-btn-secondary"
                                        title="Clear Script Options"
                                        aria-label="Clear Script Options"
                                        @onclick="ClearScriptOptions"
                                        disabled="@(!CanClearScriptOptions())">
                                    <i class="bi bi-eraser"></i>
                                    <span>Clear Script Options</span>
                                </button>

                                <button type="button"
                                        class="monitoring-panel-toggle-btn monitoring-panel-toggle-btn-gradient"
                                        @onclick="ToggleScriptOptionsSection"
                                        title="@(isScriptOptionsExpanded ? "Collapse Script Options" : "Expand Script Options")"
                                        aria-label="@(isScriptOptionsExpanded ? "Collapse Script Options" : "Expand Script Options")">
                                    <i class="bi @(isScriptOptionsExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-panel-content @(isScriptOptionsExpanded ? "expanded" : "collapsed")">
                        <div class="monitoring-panel-body-soft p-4">
                            <div class="database-option-pills">

                                <label class="database-option-pill">
                                    <input type="checkbox" @bind="scriptOptions.GenerateInDependencyOrder" />
                                    <span>Generate object in dependency order</span>
                                </label>

                                @if (objectTypeFilter == "DataScript")
                                {
                                    <label class="database-option-pill">
                                        <input type="checkbox" @bind="dataScriptGenerateInsert" />
                                        <span>Insert</span>
                                    </label>

                                    <label class="database-option-pill">
                                        <input type="checkbox" @bind="dataScriptGenerateUpdate" />
                                        <span>Update</span>
                                    </label>

                                    <label class="database-option-pill">
                                        <input type="checkbox" @bind="dataScriptGenerateDelete" />
                                        <span>Delete</span>
                                    </label>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4 monitoring-dashboard-card">
            <div class="monitoring-dashboard-header">
                <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="monitoring-dashboard-icon">
                            <i class="bi bi-diagram-3-fill"></i>
                        </div>
                        <div>
                            <h4 class="monitoring-dashboard-title mb-1">Object Explorer</h4>
                            <div class="monitoring-dashboard-subtitle">
                                Browse and select Tables, Views, Procedures, Functions, Indexes, Triggers and DataScript.
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-dashboard-right d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center gap-2 position-relative">
                        <div class="database-object-search-shell">
                            <i class="bi bi-search search-icon"></i>

                            <input class="form-control form-select-modern search-input"
                                   placeholder="Search objects..."
                                   value="@objectSearchText"
                                   @oninput="OnObjectSearchInputChanged"
                                   @onfocus="OnObjectSearchFocus"
                                   @onblur="OnObjectSearchBlurAsync" />

                            @if (!string.IsNullOrWhiteSpace(objectSearchText))
                            {
                                <button type="button"
                                        class="search-clear-btn"
                                        title="Clear search"
                                        aria-label="Clear search"
                                        @onclick="ClearObjectSearch">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            }

                            @if (showSearchSuggestions && searchSuggestions.Count > 0)
                            {
                                <div class="database-object-search-dropdown">
                                    @foreach (var suggestion in searchSuggestions)
                                    {
                                        <button type="button"
                                                class="database-object-search-item"
                                                @onmousedown='async () => await SelectSuggestionAsync(suggestion)'>
                                            <div class="database-object-search-name">@suggestion.ObjectName</div>
                                            <div class="database-object-search-meta">@suggestion.SchemaName / @suggestion.ObjectType</div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="monitoring-refresh-pill d-inline-flex align-items-center" style="white-space: nowrap">
                            <span class="monitoring-refresh-dot me-1"></span>
                            <span>@VisibleObjectCount&nbsp;visible objects</span>
                        </div>

                        <div class="monitoring-last-refresh d-inline-flex align-items-center" style="white-space: nowrap">
                            <i class="bi bi-check2-square me-1"></i>
                            Selected: @SelectedObjectCount
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="database-summary-card-grid mb-4">
                    <div class="database-summary-card">
                        <div class="database-summary-label">Visible Objects</div>
                        <div class="database-summary-value">@VisibleObjectCount</div>
                        <div class="database-summary-meta">Based on current filters</div>
                    </div>

                    <div class="database-summary-card">
                        <div class="database-summary-label">Selected Objects</div>
                        <div class="database-summary-value">@SelectedObjectCount</div>
                        <div class="database-summary-meta">Ready for generation</div>
                    </div>

                    <div class="database-summary-card">
                        <div class="database-summary-label">Schemas</div>
                        <div class="database-summary-value">@VisibleSchemaCount</div>
                        <div class="database-summary-meta">Within filtered objects</div>
                    </div>
                </div>

                <div class="database-tree-shell fill-height">
                    <div class="monitoring-dashboard-header">
                        <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <h4 class="monitoring-dashboard-title mb-1" style="font-size:1.05rem;">Searchable Object List</h4>
                                    <div class="monitoring-dashboard-subtitle">
                                        Browse filtered objects and manage selection in one place.
                                    </div>
                                </div>
                            </div>

                            <div class="database-tree-actions">
                                <span class="database-selection-summary">
                                    <i class="bi bi-check2-all"></i>
                                    <span>@SelectedObjectCount selected</span>
                                </span>

                                <button type="button"
                                        class="database-btn-secondary"
                                        @onclick="ToggleSelectAllVisible"
                                        disabled="@(!filteredGroups.Any())">
                                    <i class="bi @(AreAllVisibleItemsSelected() ? "bi-square" : "bi-check2-square")"></i>
                                    <span>@(AreAllVisibleItemsSelected() ? "Deselect All" : "Select All")</span>
                                </button>

                                <button type="button"
                                        class="database-btn-secondary"
                                        @onclick="ToggleExpandAllVisible"
                                        disabled="@(!filteredGroups.Any())">
                                    <i class="bi @(AreAllVisibleGroupsExpanded() ? "bi-arrows-collapse" : "bi-arrows-expand")"></i>
                                    <span>@(AreAllVisibleGroupsExpanded() ? "Collapse All" : "Expand All")</span>
                                </button>

                                <button type="button"
                                        class="database-btn-secondary"
                                        @onclick="ClearSelectionAndSearch"
                                        disabled="@(!CanClearSelectionAndSearch())">
                                    <i class="bi bi-eraser"></i>
                                    <span>Clear Selection</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="database-tree-scroll">
                        @if (!isConnected)
                        {
                            <div class="database-empty-state">
                                <div>
                                    <i class="bi bi-database"></i>
                                    <div>Connect to a database to load objects.</div>
                                </div>
                            </div>
                        }
                        else if (filteredGroups.Count == 0)
                        {
                            <div class="database-empty-state">
                                <div>
                                    <i class="bi bi-funnel"></i>
                                    <div>No objects found for the current filters.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="database-tree-list">
                                @foreach (var group in filteredGroups)
                                {
                                    <li class="database-tree-node">
                                        <div class="database-tree-item @(AreAllGroupItemsSelected(group) ? "selected" : "")">
                                            <button type="button"
                                                    class="database-tree-toggle"
                                                    @onclick="() => group.IsExpanded = !group.IsExpanded">
                                                <i class="bi @(group.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                            </button>

                                            <input class="database-tree-check"
                                                   type="checkbox"
                                                   checked="@AreAllGroupItemsSelected(group)"
                                                   @onchange="(e) => ToggleGroupSelection(group, e.Value is bool val && val)" />

                                            <div class="database-tree-content">
                                                <div class="database-tree-title">
                                                    <span class="database-tree-name">@group.ObjectType</span>
                                                </div>

                                                <div class="database-tree-meta">
                                                    <span class="database-tree-badge type">@group.ObjectType</span>
                                                    <span class="database-tree-badge count">@group.Items.Count objects</span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (group.IsExpanded)
                                        {
                                            <ul class="database-tree-children">
                                                @foreach (var item in group.Items)
                                                {
                                                    <li class="database-tree-node">
                                                        <div class="database-tree-item @(item.IsSelected ? "selected" : "")">
                                                            <span class="database-tree-toggle" style="visibility:hidden;">
                                                                <i class="bi bi-chevron-right"></i>
                                                            </span>

                                                            <input class="database-tree-check" type="checkbox" @bind="item.IsSelected" />

                                                            <div class="database-tree-content">
                                                                <div class="database-tree-title">
                                                                    <span class="database-tree-name">@item.ObjectName</span>
                                                                </div>

                                                                <div class="database-tree-meta">
                                                                    <span class="database-tree-badge schema">@item.SchemaName</span>
                                                                    <span class="database-tree-badge type">@item.ObjectType</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4 monitoring-dashboard-card">
            <div class="monitoring-dashboard-header">
                <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="monitoring-dashboard-icon">
                            <i class="bi bi-file-earmark-code-fill"></i>
                        </div>
                        <div>
                            <h4 class="monitoring-dashboard-title mb-1">Output Section</h4>
                            <div class="monitoring-dashboard-subtitle">
                                Preview generated script, download SQL and ZIP, and review history.
                            </div>
                        </div>
                    </div>

                    <div class="monitoring-dashboard-right">
                        <div class="monitoring-refresh-pill @(isGenerating ? "refreshing" : "")">
                            <span class="monitoring-refresh-dot"></span>
                            <span>@(isGenerating ? "Generating script..." : "Ready for generation")</span>
                        </div>

                        <div class="monitoring-last-refresh">
                            <i class="bi bi-filetype-sql me-1"></i>
                            Preview and download
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="database-preview-shell fill-height position-relative">
                    @if (isGenerating)
                    {
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                             style="background: rgba(255,255,255,0.72); z-index: 20; border-radius: 1.25rem; backdrop-filter: blur(2px);">
                            <div class="text-center px-4 py-4">
                                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                                    <span class="visually-hidden">Generating...</span>
                                </div>
                                <div class="fw-semibold fs-5">Generating script...</div>
                                <div class="text-muted mt-1">Please wait until the preview is fully loaded.</div>
                            </div>
                        </div>
                    }

                    <div class="database-preview-toolbar">
                        <div class="database-preview-summary">
                            <span class="database-chip @(isConnected ? "active" : "")">
                                <i class="bi bi-link-45deg"></i>
                                <span>@(isConnected ? "Connected" : "Not Connected")</span>
                            </span>

                            <span class="database-chip @(SelectedObjectCount > 0 ? "active" : "")">
                                <i class="bi bi-layers-fill"></i>
                                <span>@SelectedObjectCount selected</span>
                            </span>
                        </div>

                        <div class="database-history-actions">
                            <button type="button"
                                    class="btn btn-monitoring-dashboard d-inline-flex align-items-center gap-2"
                                    @onclick="GenerateScriptAsync"
                                    disabled="@(!isConnected || !GetSelectedItems().Any() || isGenerating)">
                                <i class="bi bi-gear-wide-connected"></i>
                                <span>@(isGenerating ? "Generating..." : "Generate")</span>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(downloadHref))
                            {
                                <a class="database-btn-secondary database-download-link @(isGenerating ? "disabled pe-none opacity-50" : "")"
                                   href="@downloadHref"
                                   download="@downloadFileName">
                                    <i class="bi bi-download"></i>
                                    <span>Download</span>
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(zipDownloadHref))
                            {
                                <a class="database-btn-secondary database-download-link @(isGenerating ? "disabled pe-none opacity-50" : "")"
                                   href="@zipDownloadHref"
                                   download="@zipDownloadFileName">
                                    <i class="bi bi-file-earmark-zip-fill"></i>
                                    <span>ZIP Download</span>
                                </a>
                            }
                        </div>
                    </div>

                    @if (string.IsNullOrWhiteSpace(previewScript))
                    {
                        <div class="database-preview-empty">
                            <div>
                                <i class="bi bi-file-earmark-text"></i>
                                <div>Generated SQL preview will appear here.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="database-code-view">
                            <pre>@previewScript</pre>
                        </div>
                    }

                    <div class="database-section-divider mt-4 mb-4"></div>

                    <div class="database-section-title">
                        <div>
                            <h3>Script History</h3>
                            <p>In-memory generated script history.</p>
                        </div>

                        <div class="database-history-actions">
                            <button type="button"
                                    class="database-btn-danger-soft"
                                    @onclick="ClearHistory"
                                    disabled="@(historyEntries.Count == 0 || isGenerating)">
                                <i class="bi bi-trash3"></i>
                                <span>Clear</span>
                            </button>
                        </div>
                    </div>

                    <div class="database-history-scroll">
                        @if (historyEntries.Count == 0)
                        {
                            <div class="database-empty-state">
                                <div>
                                    <i class="bi bi-clock-history"></i>
                                    <div>No history available.</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="database-history-list">
                                @foreach (var entry in historyEntries)
                                {
                                    <div class="database-history-item">
                                        <div class="database-history-top">
                                            <div class="database-ellipsis">
                                                <div class="database-history-title">@entry.FileName</div>
                                                <div class="database-history-meta">
                                                    <span>@entry.ApplicationName</span>
                                                    <span>/</span>
                                                    <span>@entry.EnvironmentName</span>
                                                    <span>/</span>
                                                    <span>@entry.ObjectCount objects</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="database-history-meta mt-2">
                                            <span>@entry.GeneratedOn.ToString("dd-MMM-yyyy hh:mm tt")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <button type="button"
                class="scroll-to-top-btn @(showScrollToTop ? "show" : "")"
                title="Scroll to top"
                aria-label="Scroll to top"
                @onclick="ScrollToTopAsync">
            <i class="bi bi-chevron-up"></i>
        </button>
    </div>
</div>

