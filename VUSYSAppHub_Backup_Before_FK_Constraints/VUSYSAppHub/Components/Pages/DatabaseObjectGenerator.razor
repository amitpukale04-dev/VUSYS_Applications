                    @for (int i = 0; i < otpDigits.Length; i++)
                    {
                        var index = i;
                        <input id="@($"db-otp-box-{index}")"
                               class="apphub-otp-input"
                               type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="1"
                               value="@otpDigits[index]"
                               @oninput="async e => await OnOtpInputAsync(index, e)"
                               @onkeydown="async e => await OnOtpKeyDownAsync(index, e)"
                               @onpaste="async e => await OnOtpPasteAsync(index, e)"
                               @onpaste:preventDefault="true"
                               disabled="@isPopupBusy" />
                    }
                </div>

                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <button type="button"
                            class="btn btn-link apphub-resend-link p-0 text-decoration-none"
                            @onclick="ResendOtpAsync"
                            disabled="@isPopupBusy">
                        <i class="bi bi-arrow-repeat me-1"></i>
                        <span>@(isPopupBusy && currentPopupAction == "resend-otp" ? "Resending OTP..." : "Resend OTP")</span>
                    </button>

                    <div class="d-flex flex-wrap justify-content-end gap-3">
                        <button type="button"
                                class="btn btn-outline-secondary btn-launcher d-inline-flex align-items-center gap-2"
                                @onclick="CloseOtpPopup"
                                disabled="@isPopupBusy">
                            <i class="bi bi-x-circle"></i>
                            <span>Cancel</span>
                        </button>

                        <button type="button"
                                class="btn btn-monitoring-dashboard d-inline-flex align-items-center gap-2"
                                @onclick="VerifyOtpAndConnectAsync"
                                disabled="@isPopupBusy">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>@(isPopupBusy && currentPopupAction == "verify-otp" ? "Verifying..." : "Verify")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    window.appHubOtp = window.appHubOtp || {};

    window.appHubOtp.focusOtpBox = window.appHubOtp.focusOtpBox || function (elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            element.focus();
            element.select();
        }
    };

    window.appHubOtp.getClipboardText = window.appHubOtp.getClipboardText || async function () {
        try {
            if (navigator.clipboard && navigator.clipboard.readText) {
                return await navigator.clipboard.readText();
            }
        } catch (e) {
        }
        return "";
    };

    window.appHubOtp.storeOtp = window.appHubOtp.storeOtp || function (key, value) {
        localStorage.setItem(key, JSON.stringify(value));
    };

    window.appHubOtp.getOtp = window.appHubOtp.getOtp || function (key) {
        const value = localStorage.getItem(key);
        return value ? JSON.parse(value) : null;
    };

    window.appHubOtp.removeOtp = window.appHubOtp.removeOtp || function (key) {
        localStorage.removeItem(key);
    };
</script>

@code {
    private const string OtpStorageKey = "apphub.database.object.generator.otp";

    private bool isDarkMode;
    private bool isConnected;
    private bool isConnecting;
    private bool isGenerating;
    private bool isRefreshingDatabase;
    private bool showConnectionAlert;

    private bool isFiltersExpanded = true;
    private bool isScriptOptionsExpanded = true;
    private bool showScrollToTop = false;
    private bool showSearchSuggestions = false;

    private bool showLoginPopup = false;
    private bool showOtpPopup = false;
    private bool isPopupBusy = false;
    private bool focusFirstOtpBoxPending = false;

    private bool dataScriptGenerateInsert = true;
    private bool dataScriptGenerateUpdate = false;
    private bool dataScriptGenerateDelete = false;

    private string selectedApplication = string.Empty;
    private string selectedEnvironment = string.Empty;
    private string objectTypeFilter = "All";
    private string schemaFilter = "All";
    private string objectSearchText = string.Empty;

    private string connectionMessage = string.Empty;
    private string previewScript = string.Empty;

    private string downloadHref = string.Empty;
    private string downloadFileName = "database-objects.sql";

    private string zipDownloadHref = string.Empty;
    private string zipDownloadFileName = "database-objects.zip";

    private string loginIdInput = string.Empty;
    private string loginPopupErrorMessage = string.Empty;
    private string loginPopupInfoMessage = string.Empty;
    private string otpPopupErrorMessage = string.Empty;
    private string otpPopupInfoMessage = string.Empty;
    private string currentPopupAction = string.Empty;
    private string[] otpDigits = new string[6] { "", "", "", "", "", "" };

    private DateTime? lastActionAt;

    private DbGeneratorConnectionConfig currentConfig = new();
    private ScriptGenerationOptions scriptOptions = new();
    private EmployeeLoginValidationResultModel validatedEmployee = new();

    private List<DbGeneratorConnectionConfig> allConnections = new();
    private List<string> applicationList = new();
    private List<string> environmentList = new();
    private List<string> schemaList = new();

    private List<DbObjectItem> allObjects = new();
    private List<DbObjectGroup> allGroups = new();
    private List<DbObjectGroup> filteredGroups = new();
    private List<DbObjectItem> searchSuggestions = new();

    private List<ScriptHistoryEntry> historyEntries = new();

    private DotNetObjectReference<DatabaseObjectGenerator>? dotNetRef;
    private CancellationTokenSource? alertCancellationTokenSource;
    private CancellationTokenSource? searchBlurCancellationTokenSource;
    private bool scrollListenerRegistered = false;

    private string passwordMask => string.IsNullOrWhiteSpace(currentConfig.Password)
        ? string.Empty
        : new string('*', Math.Min(currentConfig.Password.Length, 8));

    private int SelectedObjectCount => allObjects.Count(x => x.IsSelected);
    private int VisibleObjectCount => filteredGroups.Sum(x => x.Items.Count);
    private int VisibleSchemaCount => filteredGroups
        .SelectMany(x => x.Items)
        .Select(x => x.SchemaName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadConnectionMasterDataAsync();
            historyEntries = ScriptHistoryStore.GetAll();
        }
        catch (Exception ex)
        {
            isConnected = false;
            connectionMessage = ex.Message;
            await ShowConnectionAlertAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isDarkMode = await JS.InvokeAsync<bool>("themeManager.getCurrentThemeIsDark");

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("appHubScroll.registerScrollListener", dotNetRef);
            scrollListenerRegistered = true;

            StateHasChanged();
        }

        if (focusFirstOtpBoxPending && showOtpPopup)
        {
            focusFirstOtpBoxPending = false;
            await JS.InvokeVoidAsync("appHubOtp.focusOtpBox", "db-otp-box-0");
        }
    }

    private async Task LoadConnectionMasterDataAsync()
    {
        try
        {
            allConnections = await DatabaseObjectGeneratorService.GetConnectionConfigurationsAsync();

            var configuredApplications = allConnections
                .Select(x => x.ApplicationName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var applicationNamesFromJson = await DatabaseObjectGeneratorService.GetApplicationNamesAsync();

            applicationList = applicationNamesFromJson
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            if (applicationList.Count == 0)
            {
                applicationList = configuredApplications
                    .OrderBy(x => x)
                    .ToList();
            }
            else
            {
                foreach (var configuredApp in configuredApplications)
                {
                    if (!applicationList.Contains(configuredApp, StringComparer.OrdinalIgnoreCase))
                    {
                        applicationList.Add(configuredApp);
                    }
                }

                applicationList = applicationList
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x)
                    .ToList();
            }
        }
        catch
        {
            throw;
        }
    }

    private void BackToHome()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ToggleThemeAsync()
    {
        isDarkMode = await JS.InvokeAsync<bool>("themeManager.toggleTheme");
    }

    private void ToggleFiltersSection()
    {
        isFiltersExpanded = !isFiltersExpanded;
    }

    private void ToggleScriptOptionsSection()
    {
        isScriptOptionsExpanded = !isScriptOptionsExpanded;
    }

    private async Task ScrollToTopAsync()
    {
        await JS.InvokeVoidAsync("appHubScroll.scrollToTop");
    }

    [JSInvokable]
    public async Task UpdateScrollToTopVisibility(bool visible)
    {
        if (showScrollToTop == visible)
            return;

        showScrollToTop = visible;
        await InvokeAsync(StateHasChanged);
    }

    private string GetActionStatusText()
    {
        if (isConnecting)
            return "Connecting";

        if (isRefreshingDatabase)
            return "Refreshing database...";

        if (isGenerating)
            return "Generating script...";

        if (isPopupBusy && currentPopupAction == "send-otp")
            return "Sending OTP...";

        if (isPopupBusy && currentPopupAction == "resend-otp")
            return "Resending OTP...";

        if (isPopupBusy && currentPopupAction == "verify-otp")
            return "Verifying OTP...";

        if (showLoginPopup || showOtpPopup)
            return "Waiting for OTP verification";

        if (isConnected)
            return "Connected";

        return "Waiting for database connection";
    }

    private Task OnApplicationChanged(ChangeEventArgs args)
    {
        selectedApplication = args.Value?.ToString()?.Trim() ?? string.Empty;

        ResetEnvironmentAndConnectionDetails();

        var filterApplication = selectedApplication.Equals("Sharpply PWA", StringComparison.OrdinalIgnoreCase) ? "Sharpply" : selectedApplication;

        environmentList = allConnections
            .Where(x => x.ApplicationName.Equals(filterApplication, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.EnvironmentName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        return Task.CompletedTask;
    }

    private Task OnEnvironmentChanged(ChangeEventArgs args)
    {
        selectedEnvironment = args.Value?.ToString()?.Trim() ?? string.Empty;

        var filterApplication = selectedApplication.Equals("Sharpply PWA", StringComparison.OrdinalIgnoreCase) ? "Sharpply" : selectedApplication;

        currentConfig = allConnections.FirstOrDefault(x =>
            x.ApplicationName.Equals(filterApplication, StringComparison.OrdinalIgnoreCase) &&
            x.EnvironmentName.Equals(selectedEnvironment, StringComparison.OrdinalIgnoreCase))
            ?? CreateEmptyConnectionConfig(filterApplication, selectedEnvironment);

        ResetConnectedState(keepSelectionValues: true, clearMessage: true);
        return Task.CompletedTask;
    }

    private Task OnObjectTypeFilterChanged(ChangeEventArgs args)
    {
        objectTypeFilter = args.Value?.ToString() ?? "All";

        if (!string.Equals(objectTypeFilter, "DataScript", StringComparison.OrdinalIgnoreCase))
        {
            dataScriptGenerateInsert = false;
            dataScriptGenerateUpdate = false;
            dataScriptGenerateDelete = false;

            scriptOptions.IncludeInsert = false;
            scriptOptions.IncludeUpdate = false;
            scriptOptions.IncludeDelete = false;
        }

        ApplyFilters();
        return Task.CompletedTask;
    }

    private Task OnSchemaFilterChanged(ChangeEventArgs args)
    {
        schemaFilter = args.Value?.ToString() ?? "All";
        ApplyFilters();
        return Task.CompletedTask;
    }

    private async Task OpenLoginPopupAsync()
    {
        try
        {
            if (!CanConnect())
            {
                connectionMessage = "Please select Application and Environment.";
                isConnected = false;
                await ShowConnectionAlertAsync();
                return;
            }

            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);

            loginIdInput = string.Empty;
            loginPopupErrorMessage = string.Empty;
            loginPopupInfoMessage = string.Empty;
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.Empty;
            validatedEmployee = new EmployeeLoginValidationResultModel();
            ClearOtpInputs();

            showLoginPopup = true;
            showOtpPopup = false;
        }
        catch (Exception ex)
        {
            connectionMessage = ex.Message;
            await ShowConnectionAlertAsync();
        }
    }

    private async Task ValidateLoginAndSendOtpAsync()
    {
        try
        {
            loginPopupErrorMessage = string.Empty;
            loginPopupInfoMessage = string.Empty;

            if (string.IsNullOrWhiteSpace(selectedApplication) || string.IsNullOrWhiteSpace(selectedEnvironment))
            {
                loginPopupErrorMessage = "Please select Application and Environment.";
                return;
            }

            if (string.IsNullOrWhiteSpace(loginIdInput))
            {
                loginPopupErrorMessage = selectedApplication?.Equals("TimePro", StringComparison.OrdinalIgnoreCase) == true
                    ? "Please enter Email ID."
                    : "Please enter Login ID.";
                return;
            }

            if (selectedApplication?.Equals("TimePro", StringComparison.OrdinalIgnoreCase) == true)
            {
                if (!loginIdInput.Contains("@") || !loginIdInput.Contains("."))
                {
                    loginPopupErrorMessage = "Please enter valid Email ID.";
                    return;
                }
            }

            isPopupBusy = true;
            currentPopupAction = "send-otp";

            var objEmployeeLoginValidationRequestModel = new EmployeeLoginValidationRequestModel
            {
                ApplicationName = selectedApplication,
                EnvironmentName = selectedEnvironment,
                LoginID = loginIdInput
            };

            var validationResult = await DatabaseObjectGeneratorService.ValidateLoginIdAsync(objEmployeeLoginValidationRequestModel);

            bool isTimePro = selectedApplication?.Equals("TimePro", StringComparison.OrdinalIgnoreCase) == true;

            if (!validationResult.IsValid)
            {
                loginPopupErrorMessage = string.IsNullOrWhiteSpace(validationResult.ErrorMessage)
                    ? (isTimePro ? "Invalid Email ID." : "Invalid Login ID.")
                    : validationResult.ErrorMessage;

                return;
            }

            if (string.IsNullOrWhiteSpace(validationResult.EmailId))
            {
                loginPopupErrorMessage = "Email ID is not configured for this Login ID.";
                return;
            }

            validatedEmployee = validationResult;

            var otpSendMessage = await SendAndStoreOtpAsync(false);

            showLoginPopup = false;
            showOtpPopup = true;
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.IsNullOrWhiteSpace(otpSendMessage)
                ? $"OTP has been sent to {validatedEmployee.EmailId}."
                : otpSendMessage;
            ClearOtpInputs();
            focusFirstOtpBoxPending = true;
        }
        catch (Exception ex)
        {
            loginPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResendOtpAsync()
    {
        try
        {
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.Empty;

            if (!validatedEmployee.IsValid || string.IsNullOrWhiteSpace(validatedEmployee.LoginId) || string.IsNullOrWhiteSpace(validatedEmployee.EmailId))
            {
                otpPopupErrorMessage = "Validated employee details not found. Please start the process again.";
                return;
            }

            isPopupBusy = true;
            currentPopupAction = "resend-otp";

            var otpSendMessage = await SendAndStoreOtpAsync(true);

            otpPopupInfoMessage = string.IsNullOrWhiteSpace(otpSendMessage) ? $"A New OTP has been sent to {validatedEmployee.EmailId}." : otpSendMessage;
            ClearOtpInputs();
            focusFirstOtpBoxPending = true;
        }
        catch (Exception ex)
        {
            otpPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string> SendAndStoreOtpAsync(bool isResend)
    {
        var otp = GenerateSixDigitOtp();
        var expiryMinutes = Convert.ToInt32(CommonHelper.KeyOption.OTPExpiryInMinutes);
        var expiryUtc = DateTime.UtcNow.AddMinutes(expiryMinutes);

        var sendOtpModel = new DeploymentSendOtpModel
        {
            LoginId = validatedEmployee.LoginId,
            EmployeeName = validatedEmployee.EmployeeName,
            EmailId = validatedEmployee.EmailId,
            ApplicationName = selectedApplication,
            Environment = selectedEnvironment,
            NewVersion = "Database Object Generation Connection",
            Otp = otp,
            ExpiryInMinutes = expiryMinutes.ToString()
        };

        var sendOtpResponse = await DatabaseObjectGeneratorService.SendDatabaseObjectGenerationOtpAsync(sendOtpModel);

        var storageModel = new DeploymentVersionOtpStorageModel
        {
            LoginId = validatedEmployee.LoginId,
            EmployeeName = validatedEmployee.EmployeeName,
            EmailId = validatedEmployee.EmailId,
            Otp = otp,
            ExpiryUtc = expiryUtc,
            ApplicationName = selectedApplication,
            Environment = selectedEnvironment,
            NewVersion = "Database Object Generation Connection"
        };

        await JS.InvokeVoidAsync("appHubOtp.storeOtp", OtpStorageKey, storageModel);

        return sendOtpResponse;
    }

    private async Task VerifyOtpAndConnectAsync()
    {
        try
        {
            otpPopupErrorMessage = string.Empty;
            otpPopupInfoMessage = string.Empty;

            var enteredOtp = string.Concat(otpDigits);

            if (string.IsNullOrWhiteSpace(enteredOtp) || enteredOtp.Length != 6 || enteredOtp.Any(x => !char.IsDigit(x)))
            {
                otpPopupErrorMessage = "Please enter valid 6-digit OTP.";
                return;
            }

            isPopupBusy = true;
            currentPopupAction = "verify-otp";

            var storedOtp = await JS.InvokeAsync<DeploymentVersionOtpStorageModel?>("appHubOtp.getOtp", OtpStorageKey);

            if (storedOtp == null)
            {
                otpPopupErrorMessage = "OTP not found. Please request OTP again.";
                return;
            }

            if (storedOtp.ExpiryUtc <= DateTime.UtcNow)
            {
                await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
                otpPopupErrorMessage = "OTP has expired. Please click Resend OTP.";
                return;
            }

            if (!string.Equals(storedOtp.ApplicationName, selectedApplication, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.Environment, selectedEnvironment, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.LoginId, validatedEmployee.LoginId, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(storedOtp.EmailId, validatedEmployee.EmailId, StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
                otpPopupErrorMessage = "OTP session is invalid. Please start again.";
                return;
            }

            if (!string.Equals(storedOtp.Otp, enteredOtp, StringComparison.Ordinal))
            {
                otpPopupErrorMessage = "OTP is not valid.";
                return;
            }

            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);

            showOtpPopup = false;
            showLoginPopup = false;

            await PerformDatabaseConnectionAsync();
        }
        catch (Exception ex)
        {
            otpPopupErrorMessage = ex.Message;
        }
        finally
        {
            isPopupBusy = false;
            currentPopupAction = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PerformDatabaseConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedApplication) ||
            string.IsNullOrWhiteSpace(selectedEnvironment) ||
            string.IsNullOrWhiteSpace(currentConfig.ApplicationName) ||
            string.IsNullOrWhiteSpace(currentConfig.EnvironmentName))
        {
            connectionMessage = "Please select Application and Environment.";
            isConnected = false;
            await ShowConnectionAlertAsync();
            return;
        }

        isConnecting = true;
        connectionMessage = string.Empty;

        try
        {
            var result = await DatabaseObjectGeneratorService.TestConnectionAsync(currentConfig);
            isConnected = result.Success;
            connectionMessage = result.Message;
            lastActionAt = DateTime.Now;

            if (result.Success)
            {
                allObjects = await DatabaseObjectGeneratorService.GetDatabaseObjectsAsync(currentConfig);
                schemaList = allObjects
                    .Select(x => x.SchemaName)
                    .Where(x => !string.IsNullOrWhiteSpace(x) &&
                                x.Equals("DBA", StringComparison.OrdinalIgnoreCase))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x)
                    .ToList();

                BuildGroups();
                ApplyFilters();
            }
            else
            {
                ClearLoadedObjects();
                ApplyFilters();
            }

            await ShowConnectionAlertAsync();
        }
        catch (Exception ex)
        {
            isConnected = false;
            connectionMessage = ex.Message;
            ClearLoadedObjects();
            ApplyFilters();
            await ShowConnectionAlertAsync();
        }
        finally
        {
            isConnecting = false;
        }
    }

    private async Task RefreshDatabaseAsync()
    {
        if (!CanRefreshDatabase())
        {
            return;
        }

        isRefreshingDatabase = true;
        connectionMessage = string.Empty;

        try
        {
            allObjects = await DatabaseObjectGeneratorService.GetDatabaseObjectsAsync(currentConfig);
            schemaList = allObjects
                .Select(x => x.SchemaName)
                .Where(x => !string.IsNullOrWhiteSpace(x) &&
                            x.Equals("DBA", StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            BuildGroups();
            ApplyFilters();

            connectionMessage = "Database Refreshed Successfully !!!";
            lastActionAt = DateTime.Now;

            await ShowConnectionAlertAsync();
        }
        catch (Exception ex)
        {
            isConnected = false;
            connectionMessage = ex.Message;
            await ShowConnectionAlertAsync();
        }
        finally
        {
            isRefreshingDatabase = false;
        }
    }

    private async Task DisconnectAsync()
    {
        if (!CanDisconnect())
        {
            return;
        }

        ResetConnectedState(keepSelectionValues: true, clearMessage: false);
        connectionMessage = "Database Disconnected Successfully !!!";
        lastActionAt = DateTime.Now;

        try
        {
            await JS.InvokeVoidAsync("appHubOtp.removeOtp", OtpStorageKey);
        }
        catch
        {
        }

        await ShowConnectionAlertAsync();
    }

    private void BuildGroups()
    {
        allGroups = allObjects
            .GroupBy(x => x.ObjectType)
            .OrderBy(g => GetGroupOrder(g.Key))
            .Select(g => new DbObjectGroup
            {
                ObjectType = g.Key,
                IsExpanded = true,
                Items = g.OrderBy(x => x.SchemaName).ThenBy(x => x.ObjectName).ToList()
            })
            .ToList();
    }

    private void ApplyFilters()
    {
        IEnumerable<DbObjectItem> filtered = allObjects;

        if (!string.Equals(objectTypeFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            filtered = filtered.Where(x => x.ObjectType.Equals(objectTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(schemaFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            filtered = filtered.Where(x => x.SchemaName.Equals(schemaFilter, StringComparison.OrdinalIgnoreCase));
        }

        var currentExpansion = filteredGroups.Any()
            ? filteredGroups.ToDictionary(x => x.ObjectType, x => x.IsExpanded)
            : allGroups.ToDictionary(x => x.ObjectType, x => x.IsExpanded);

        filteredGroups = filtered
            .GroupBy(x => x.ObjectType)
            .OrderBy(g => GetGroupOrder(g.Key))
            .Select(g => new DbObjectGroup
            {
                ObjectType = g.Key,
                IsExpanded = currentExpansion.TryGetValue(g.Key, out var expanded) ? expanded : true,
                Items = g.OrderBy(x => x.SchemaName).ThenBy(x => x.ObjectName).ToList()
            })
            .ToList();

        UpdateSearchSuggestions();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateSearchSuggestions()
    {
        if (!isConnected || string.IsNullOrWhiteSpace(objectSearchText))
        {
            searchSuggestions.Clear();
            showSearchSuggestions = false;
            return;
        }

        var search = objectSearchText.Trim();

        var suggestionSource = filteredGroups
            .SelectMany(x => x.Items)
            .ToList();

        searchSuggestions = suggestionSource
            .Where(x =>
                x.ObjectName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                x.SchemaName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                x.ObjectType.Contains(search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.ObjectName.Equals(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(x => x.ObjectName.StartsWith(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(x => GetObjectTypeSearchPriority(x.ObjectType))
            .ThenBy(x => x.ObjectName)
            .ThenBy(x => x.SchemaName)
            .Take(20)
            .ToList();

        showSearchSuggestions = searchSuggestions.Count > 0;
    }

    private static int GetObjectTypeSearchPriority(string objectType)
    {
        return objectType switch
        {
            "Table" => 1,
            "View" => 2,
            "Procedure" => 3,
            "Function" => 4,
            "Index" => 5,
            "Trigger" => 6,
            "DataScript" => 7,
            _ => 99
        };
    }

    private Task OnObjectSearchInputChanged(ChangeEventArgs args)
    {
        objectSearchText = args.Value?.ToString() ?? string.Empty;
        searchBlurCancellationTokenSource?.Cancel();
        UpdateSearchSuggestions();
        return Task.CompletedTask;
    }

    private Task OnObjectSearchFocus(FocusEventArgs _)
    {
        searchBlurCancellationTokenSource?.Cancel();
        UpdateSearchSuggestions();
        return Task.CompletedTask;
    }

    private async Task OnObjectSearchBlurAsync(FocusEventArgs _)
    {
        searchBlurCancellationTokenSource?.Cancel();
        searchBlurCancellationTokenSource = new CancellationTokenSource();
        var token = searchBlurCancellationTokenSource.Token;

        try
        {
            await Task.Delay(220, token);
            showSearchSuggestions = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void ClearObjectSearch()
    {
        searchBlurCancellationTokenSource?.Cancel();
        objectSearchText = string.Empty;
        showSearchSuggestions = false;
        searchSuggestions.Clear();
    }

    private async Task SelectSuggestionAsync(DbObjectItem suggestion)
    {
        searchBlurCancellationTokenSource?.Cancel();

        var matched = allObjects.FirstOrDefault(x =>
            x.ObjectName.Equals(suggestion.ObjectName, StringComparison.OrdinalIgnoreCase) &&
            x.SchemaName.Equals(suggestion.SchemaName, StringComparison.OrdinalIgnoreCase) &&
            x.ObjectType.Equals(suggestion.ObjectType, StringComparison.OrdinalIgnoreCase));

        if (matched != null)
        {
            matched.IsSelected = true;
        }

        foreach (var group in filteredGroups.Where(x =>
                     x.ObjectType.Equals(suggestion.ObjectType, StringComparison.OrdinalIgnoreCase)))
        {
            group.IsExpanded = true;
        }

        objectSearchText = suggestion.ObjectName;
        UpdateSearchSuggestions();
        showSearchSuggestions = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowConnectionAlertAsync()
    {
        showConnectionAlert = !string.IsNullOrWhiteSpace(connectionMessage);

        if (!showConnectionAlert)
        {
            return;
        }

        await InvokeAsync(StateHasChanged);

        alertCancellationTokenSource?.Cancel();
        alertCancellationTokenSource?.Dispose();
        alertCancellationTokenSource = new CancellationTokenSource();
        var token = alertCancellationTokenSource.Token;

        try
        {
            await Task.Delay(4000, token);
            showConnectionAlert = false;
            connectionMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

