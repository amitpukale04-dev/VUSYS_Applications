@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Edit Role";
	Layout = "_CommonNavLayout";
}

<form id="EditRoleForm" asp-action="EditRole" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit Role</h3>
						</div>
						<input type="hidden" asp-for="RoleMaster.Id" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditRole")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>