@model VUSYSTimeProWebApp.ViewModels.AllViewModel;

<style>
	#tblViewTimeSheetList td:nth-child(6) {
		white-space: normal !important;
		word-break: break-word;
		vertical-align: top;
	}

	#tblViewTimeSheetList td ol {
		padding-left: 18px;
		margin: 0;
	}

	#tblViewTimeSheetList td li {
		margin-bottom: 3px;
	}
</style>

<div class="modal fade" id="modalReason" tabindex="-1" role="dialog" aria-labelledby="modalReasonLabel" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalReasonTitle"></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<div class="form-group">
					<div class="form-group d-flex align-items-center">
						<label for="displayApprovalStatus" id="displayApprovalStatusLabel" class="mr-2 mb-0">Approval Status:</label>
						<p id="displayApprovalStatus" class="mb-0" style="font-weight: bold;">></p>
					</div>
				</div>
				<div class="form-group">
					<div class="form-group d-flex align-items-center">
						<label for="displayApprovedRejectedUser" id="displayApprovedRejectedUserLabel" class="mr-2 mb-0"></label>
						<p id="displayApprovedRejectedUser" class="mb-0" style="font-weight: bold;">></p>
					</div>
				</div>
				<div class="form-group">
					<div class="form-group d-flex align-items-center">
						<label for="displayApprovedRejectedDateTime" id="displayApprovedRejectedDateTimeLabel" class="mr-2 mb-0"></label>
						<p id="displayApprovedRejectedDateTime" class="mb-0" style="font-weight: bold;">></p>
					</div>
				</div>
				<div class="form-group">
					<div class="form-group d-flex align-items-center">
						<label for="displayReason" id="displayReasonLabel" class="mr-2 mb-0"></label>
						<p id="displayReason" class="mb-0" style="font-weight: bold;"></p>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-danger btn-mgn" data-dismiss="modal"><i class="fas fa-close"></i> Cancel</button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="modalApproveReject" tabindex="-1" role="dialog" aria-labelledby="modalApproveRejectLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalApproveRejectTitle">Timesheet Approve/Reject</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<div class="row form-group">
					<input type="hidden" id="hdnProjectTimesheetID" />
					<div class="col-sm-6 col-md-4 left">
						<div class="col-sm-12 col-md-6 mandatory">
							<label asp-for="projectTimesheetApproveRejection.EmployeeCode" class="control-label"></label>
						</div>
						<div class="col-sm-12 col-md-10">
							<input asp-for="projectTimesheetApproveRejection.EmployeeCode" class="form-control" readonly />
							<span asp-validation-for="projectTimesheetApproveRejection.EmployeeCode" class="text-danger"></span>
						</div>
					</div>

					<div class="col-sm-6 col-md-4 left">
						<div class="col-sm-12 col-md-6 mandatory">
							<label asp-for="projectTimesheetApproveRejection.TimesheetMonth" class="control-label"></label>
						</div>
						<div class="col-sm-12 col-md-10">
							<input asp-for="projectTimesheetApproveRejection.TimesheetMonth" class="form-control" readonly />
							<span asp-validation-for="projectTimesheetApproveRejection.TimesheetMonth" class="text-danger"></span>
						</div>
					</div>

					<div class="col-sm-6 col-md-4 left">
						<div class="col-sm-12 col-md-6 mandatory">
							<label asp-for="projectTimesheetApproveRejection.TimesheetYear" class="control-label"></label>
						</div>
						<div class="col-sm-12 col-md-10">
							<input asp-for="projectTimesheetApproveRejection.TimesheetYear" class="form-control" readonly />
							<span asp-validation-for="projectTimesheetApproveRejection.TimesheetYear" class="text-danger"></span>
						</div>
					</div>
				</div>
				<div class="row form-group">
					<div class="col-sm-6 col-md-4 left">
						<div class="col-sm-12 col-md-6 mandatory">
							<label asp-for="projectTimesheetApproveRejection.ProjectTimeSheetApprovalStatusID" class="control-label"></label>
						</div>
						<div class="col-sm-12 col-md-10">
							<select class="form-control" id="ddlProjectTimesheetApprovalStatus" asp-for="projectTimesheetApproveRejection.ProjectTimeSheetApprovalStatusID">
								<option value="">SELECT</option>
								<option value="0">Reject</option>
								<option value="1">Approve</option>
							</select>
							<span asp-validation-for="projectTimesheetApproveRejection.ProjectTimeSheetApprovalStatusID" class="text-danger"></span>
						</div>
					</div>
					<div class="col-sm-6 col-md-8 left">
						<div class="col-sm-12 col-md-6 mandatory">
							<label asp-for="projectTimesheetApproveRejection.Remarks" class="control-label"></label>
						</div>
						<div class="col-sm-12 col-md-11">
							<textarea asp-for="projectTimesheetApproveRejection.Remarks" id="txtRemarks" class="form-control"></textarea>
							<span asp-validation-for="projectTimesheetApproveRejection.Remarks" class="text-danger"></span>
						</div>
					</div>
					<button type="button" id="btnViewTimesheet" class="btn btn-link" title="Click to view the timesheet" onclick="ViewTimeSheetDetails(this)">View Timesheet</button>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" id="btnApproveReject" class="btn btn-success btn-mgn VUSYSbg" name="action" value="ApproveTimesheet" onclick="confirmApproveReject(this)">
					<i class="fas fa-save"></i> Save
				</button>
				<button type="button" class="btn btn-danger btn-mgn" data-dismiss="modal"><i class="fas fa-close"></i> Cancel</button>
			</div>
		</div>
	</div>
</div>

@await Html.PartialAsync("_ViewTimeSheetDetailsPopup")

<div class="container">
	<div style="width:100%; margin:0 auto;">
		<table id="tblTimesheetApproveRejectList" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
			<thead class="VUSYSTableHeader">
				<tr>
					<th>Action(s)</th>
					<th>SL No.</th>
					<th>Employee Code</th>
					<th>Name</th>
					<th>Month</th>
					<th>Year</th>
					<th>No. of Hours Worked</th>
					<th>Approval Status</th>
					<th>Approved/Rejected Details</th>
				</tr>
			</thead>
		</table>
	</div>
</div>

<script>
	$(document).ready(function () {
		BindTimesheetApproveRejectListGrid();
	});

	function BindTimesheetApproveRejectListGrid() {
		var EmployeeCode = $("#ddlEmployee").val();
		var TimesheetMonth = $("#ddlMonth").val();
		var TimesheetYear = $("#ddlYear").val();
		var baseUrl = '@Url.Action("GetTimeSheetApproveRejectList", "TimesheetApprovalRejection")';
		// Dynamically append query parameters to the URL
		var url = baseUrl + '?EmployeeCode=' + encodeURIComponent(EmployeeCode) + '&Month=' + encodeURIComponent(TimesheetMonth) + '&Year=' + encodeURIComponent(TimesheetYear);

		var rtable = $("#tblTimesheetApproveRejectList").DataTable({
			"processing": true, // for show progress bar
			"serverSide": true, // for process server side
			"filter": true, // this is for disable filter (search box)
			"orderMulti": false, // for disable multiple column at once
			"scrollX": true,
			"scrollCollapse": true,
			"lengthMenu": [[10, 25, 50, -1], [10, 25, 50, 'All']],
			"paging": true,
			"ajax": {
				"url": url,
				"type": "POST",
				"datatype": "json"
			},
			"language": {
				"emptyTable": "No Record Found.",
				"processing":
					'<i class="fa fa-spinner fa-spin fa-3x fa-fw" style="color:#2a2b2b;"></i><span class="sr-only">Loading...</span> '
			},
			"columns": [
				{
					"data": "otherParameters",
					"render": function (data) {
						var inputValue = data;
						var inputArrayValue = inputValue.split('^');
						var ButtonText = inputArrayValue[0];
						var EmployeeCode = inputArrayValue[1];
						var IsShowApproveRejectButton = inputArrayValue[2];
						var ProjectTimeSheetID = inputArrayValue[3];
						var TimesheetMonth = inputArrayValue[4];
						var TimesheetYear = inputArrayValue[5];
						var StartDiv = `<div class="d-flex align-items-center" style="gap: 10px;">`;
						var DynamicContentDiv = '';
						var EndDiv = `</div>`;
						if (IsShowApproveRejectButton != null && IsShowApproveRejectButton != '' && IsShowApproveRejectButton == 'True')
						{
							if (ProjectTimeSheetID != null && ProjectTimeSheetID != '') {
								DynamicContentDiv = DynamicContentDiv + `<button type="button" class="btn btn-link d-flex align-items-center" style="cursor:pointer; gap: 6px;" data-toggle="tooltip" data-placement="top" title="Click Here To Approve/Reject" data-ProjectTimeSheetID=${ProjectTimeSheetID} data-EmployeeCode=${EmployeeCode} data-TimesheetMonth=${TimesheetMonth} data-TimesheetYear=${TimesheetYear} onclick="return ApproveRejectPopup(this);"><i class="fas fa-check text-success"></i><i class="fas fa-times text-danger"></i></button>`;
								DynamicContentDiv = DynamicContentDiv + '<div style="border-left: 2px solid #ddd; height: 30px;"></div>';
								DynamicContentDiv = DynamicContentDiv + `<button type="button" class="btn btn-link" style="cursor:pointer" data-toggle="tooltip" data-placement="top" title="Click Here To Download Timesheet" data-href="@Url.Action("DownloadTimesheetToExcel", "TimesheetApprovalRejection")/?ProjectTimeSheetID=${ProjectTimeSheetID}&EmployeeCode=${EmployeeCode}&TimesheetMonth=${TimesheetMonth}&TimesheetYear=${TimesheetYear}" onclick="DownloadTimesheet(this);"><i class="fas fa-download text-info"></i></button>`;

								return StartDiv + DynamicContentDiv + EndDiv.toString();
							}
						}
						else
						{
							DynamicContentDiv = DynamicContentDiv + `<button type="button" class="btn btn-link" style="cursor:pointer" data-toggle="tooltip" data-placement="top" title="Click Here To Download Timesheet" data-href="@Url.Action("DownloadTimesheetToExcel", "TimesheetApprovalRejection")/?ProjectTimeSheetID=${ProjectTimeSheetID}&EmployeeCode=${EmployeeCode}&TimesheetMonth=${TimesheetMonth}&TimesheetYear=${TimesheetYear}" onclick="DownloadTimesheet(this);"><i class="fas fa-download text-info"></i></button>`;
							return StartDiv + DynamicContentDiv + EndDiv.toString();
						}
					},
					"width": "10%"
				},
				{ "data": "slNo", "name": "slNo", "width": "0%" },
				{ "data": "employeeCode", "name": "employeeCode", "width": "10%" },
				{ "data": "fullName", "name": "fullName", "width": "10%" },
				{ "data": "timeSheetMonth", "name": "timeSheetMonth", "width": "10%" },
				{ "data": "timeSheetYear", "name": "timeSheetYear", "width": "10%" },
				{ "data": "totalHoursWorked", "name": "totalHoursWorked", "width": "10%" },
				{ "data": "timesheetApprovalStatus", "name": "timesheetApprovalStatus", "width": "10%" },
				{
					"data": "approvedRejectedParameters",
					"render": function (data) {
						var inputValue = data;
						var inputArrayValue = inputValue.split('^');
						var ApprovalStatus = inputArrayValue[0];
						var ApprovedOrRejectedByUser = inputArrayValue[1];
						var ApprovedOrRejectedByUser = inputArrayValue[1];
						var ApprovedOrRejectedReason = inputArrayValue[2];
						var ApprovedOrRejectedDateTime = inputArrayValue[3];
						var IsShowViewDetailsButton = inputArrayValue[4];
						var StartDiv = `<div class="text-center" id="dvReason">`;
						var DynamicContentDiv = '';
						var EndDiv = `</div>`;
						if (IsShowViewDetailsButton != null && IsShowViewDetailsButton != '' && IsShowViewDetailsButton == 'True')
						{
							DynamicContentDiv = DynamicContentDiv + `<button type="button" class="btn btn-link" id="btnViewReason" data-toggle="tooltip" data-placement="top" title="Click Here To View Reason" style="cursor:pointer" data-approvalstatus="${ApprovalStatus}" data-approvedrejecteduser="${ApprovedOrRejectedByUser}" data-reason="${ApprovedOrRejectedReason}" data-approvedrejecteddatetime="${ApprovedOrRejectedDateTime}" onclick="ReasonPopup(this);">View Details</button>&nbsp;`; return StartDiv + DynamicContentDiv + EndDiv.toString();
						}
						else
						{
							return StartDiv + DynamicContentDiv + EndDiv.toString();
						}
					},
					"width": "10%"
				}
			]

		});
	}
</script>

