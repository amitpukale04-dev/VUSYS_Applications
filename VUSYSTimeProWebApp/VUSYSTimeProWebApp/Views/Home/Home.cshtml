@{
    ViewData["Title"] = "Home";
    Layout = "_CommonNavLayout";
}

@if (ViewBag.DisplayButtons != null && ViewBag.DisplayButtons == true)
{
    <section class="content">
        <div class="container-fluid">
            <div class="row form-group">
                <div class="col-lg-3 col-md-6">
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>
                                <label Style="font-size: 15px; color: white;">Log Timesheet</label>
                            </h3>
                        </div>
                        <div class="icon">
                            <i class="fa fa-clock fa-lg-5x"></i>
                        </div>
                        <a asp-action="GetAllTimesheetList" asp-controller="/Timesheet"> Click Here <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>
                                <label Style="font-size: 15px; color: white;">Submit Timesheet For Approval</label>
                            </h3>
                        </div>
                        <div class="icon">
                            <i class="fa fa-paper-plane fa-lg-5x"></i>
                        </div>
                        <a asp-action="GetAllTimesheetSubmissionList" asp-controller="/TimesheetSubmission"> Click Here <i class="fa fa-arrow-circle-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

