@model VUSYSTimeProWebApp.ViewModels.AllViewModel;

@{
	ViewData["Title"] = "Add Email Configuration";
	Layout = "_CommonNavLayout";
}
<form id="CreateEmailConfigurationForm" asp-action="CreateEmailConfiguration" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Add Email Configuration</h3>
						</div>
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditEmailConfiguration")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>
