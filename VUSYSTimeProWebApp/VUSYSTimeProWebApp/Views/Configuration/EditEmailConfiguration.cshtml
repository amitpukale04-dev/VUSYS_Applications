@model VUSYSTimeProWebApp.ViewModels.AllViewModel;

@{
	ViewData["Title"] = "Edit Email Configuration";
	Layout = "_CommonNavLayout";
}

<form id="EditEmailConfigurationForm" asp-action="EditEmailConfiguration" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit Email Configuration </h3>
						</div>
						<input type="hidden" asp-for="EmailConfigurationMaster.Id" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditEmailConfiguration")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>
