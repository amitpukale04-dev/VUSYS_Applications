@model VUSYSTimeProWebApp.ViewModels.AllViewModel


@{
	Layout = "_LoginLayout";
	ViewData["Title"] = "Change Password";
}
<link href="~/Admin/LoginChangePassword.css" rel="stylesheet" />
<div class="hold-transition login-page customLoginChangePasswordBackgroundImage">
	<div class="login-header-text">
		<h1>Timesheet Management</h1>
		<p>Track Time. Improve Productivity.</p>
	</div>
	<div class="login-box">
		<div class="card card-outline card-primary">
			<div class="card-header text-center">
				<img src="~/Admin/dist/img/AppLogo.png" alt="Logo">
			</div>
			<div class="card-body">
				<p class="login-box-msg loginAppName">Change Password</p>
				<form asp-controller="Login" asp-action="ChangePasswordOnReset" id="ChangePasswordOnResetForm" method="post">
					<input type="hidden" asp-for="changePasswordOnReset.EmailID" />
					<div class="input-group mb-3">
						<div class="input-group-append">
							<div class="input-group-text">
								<span class="fas fa-lock"></span>
							</div>
						</div>
						<input type="password" asp-for="changePasswordOnReset.NewPassword" id="txtNewPassword" class="form-control" placeholder="New Password" />
						<span class="input-group-btn">
							<button class="btn btn-default btn-md" type="button" id="NewPasswordShowHide" data-val='1'>
								<span id='NewPasswordEye' class="fa fa-eye">
								</span>
							</button>
						</span>
					</div>
					<span asp-validation-for="changePasswordOnReset.NewPassword" class="text-danger"></span>
					<div class="input-group mb-3">
						<div class="input-group-append">
							<div class="input-group-text">
								<span class="fas fa-lock"></span>
							</div>
						</div>
						<input type="password" asp-for="changePasswordOnReset.ConfirmPassword" id="txtConfirmPassword" class="form-control" placeholder="Confirm Password" />
						<span class="input-group-btn">
							<button class="btn btn-default btn-md" type="button" id="ConfirmPasswordShowHide" data-val='1'>
								<span id='ConfirmPasswordEye' class="fa fa-eye">
								</span>
							</button>
						</span>
					</div>
					<span asp-validation-for="changePasswordOnReset.ConfirmPassword" class="text-danger"></span>
					<div class="social-auth-links text-center mt-2 mb-3">
						<button type="submit" id="btnChangePasswordOnReset" class="btn btn-block btn-lg btn-primary VUSYSbg">Change Password</button>
					</div>
					<p class="mb-1">
						<a asp-action="Login" asp-controller="Login">Back To Login</a>
					</p>
					@await Html.PartialAsync("CommonControls/_EnvironmentVersionNo")
					@if (ViewBag.ChangePasswordError != null)
					{
						<label class="form-label" id="changepassworderror" style="color:red">@ViewBag.ChangePasswordError</label>
					}
				</form>
			</div>
		</div>
	</div>
</div>

