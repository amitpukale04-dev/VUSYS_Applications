@model VUSYSTimeProWebApp.ViewModels.AllViewModel


@{
	Layout = "_LoginLayout";
	ViewData["Title"] = "Forgot Password";
}
<link href="~/Admin/ForgotPassword.css" rel="stylesheet" />
<div class="hold-transition login-page customForgotPasswordBackgroundImage">
	<div class="login-header-text">
		<h1>Timesheet Management</h1>
		<p>Track Time. Improve Productivity.</p>
	</div>
	<div class="login-box">
		<div class="card card-outline card-primary">
			<div class="card-header text-center">
				<img src="~/Admin/dist/img/AppLogo.png" alt="Logo">
			</div>
			<div class="card-body">
				<p class="login-box-msg loginAppName">Forgot Password</p>
				<form asp-controller="Login" asp-action="ForgotPassword" id="ForgotPasswordForm" method="post">
					<div class="input-group mb-3">
						<div class="input-group-append">
							<div class="input-group-text">
								<span class="fas fa-envelope"></span>
							</div>
						</div>
						<input asp-for="forgotPassword.UserEmailID" class="form-control" placeholder="Email" />
					</div>
					<span asp-validation-for="forgotPassword.UserEmailID" class="text-danger"></span>
					<div class="social-auth-links text-center mt-2 mb-3">
						<button type="submit" id="btnSendRequest" class="btn btn-block btn-lg btn-primary VUSYSbg">Send Request</button>
					</div>
					<p class="mb-1">
						<a asp-action="Login" asp-controller="Login">Back To Login</a>
					</p>
					@await Html.PartialAsync("CommonControls/_EnvironmentVersionNo")
					@if (ViewBag.ForgotPasswordError != null)
					{
						<label class="form-label" id="forgotpassworderror" style="color:red">@ViewBag.ForgotPasswordError</label>
					}
				</form>
			</div>
		</div>
	</div>
</div>