@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Edit Timesheet";
	Layout = "_CommonNavLayout";
}

<form id="EditTimesheetForm" asp-action="EditTimesheet" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit Timesheet</h3>
						</div>
						<input type="hidden" asp-for="projectTimesheet.ProjectID" />
						<input type="hidden" id="ProjectID" name="ProjectID" />
						<input type="hidden" asp-for="projectTimesheet.ProjectTimeSheetID" />
						<input type="hidden" asp-for="projectTimesheet.ProjectTimeSheetDetailID" />
						<input type="hidden" asp-for="projectTimesheet.ProjectActivityID" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditTimesheet")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>