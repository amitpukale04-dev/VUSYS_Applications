@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Edit State";
	Layout = "_CommonNavLayout";
}

<form id="EditStateForm" asp-action="EditState" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit State</h3>
						</div>
						<input type="hidden" asp-for="StateMaster.Id" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditState")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>