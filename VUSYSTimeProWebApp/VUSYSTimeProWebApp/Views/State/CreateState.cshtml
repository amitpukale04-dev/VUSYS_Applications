@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Add State";
	Layout = "~/Views/Shared/_CommonNavLayout.cshtml";
}
<form id="CreateStateForm" asp-action="CreateState" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Add State</h3>
						</div>
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditState")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>
