@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Edit Employee Project Mapping";
	Layout = "_CommonNavLayout";
}

<form id="EditEmployeeProjectMappingForm" asp-action="EditEmployeeProjectMapping" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit Employee Project Mapping</h3>
						</div>
						<input type="hidden" asp-for="employeeProjectMapping.Id" />
						<input type="hidden" asp-for="employeeProjectMapping.CreatedBy" />
						<input type="hidden" asp-for="employeeProjectMapping.CreatedDate" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditEmployeeProjectMapping")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>