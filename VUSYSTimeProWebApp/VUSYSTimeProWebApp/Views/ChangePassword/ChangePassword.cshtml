@model VUSYSTimeProWebApp.ViewModels.AllViewModel;

@{
    ViewData["Title"] = "Change Password";
	Layout = "_CommonNavLayout";
}

<form id="ChangePasswordForm" asp-action="ChangePassword" method="post">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Logged-In User Change Password</h3>
						</div>
						<div class="card-body" style="padding-left:10px;">
							<div class="row form-group">
								<div class="col-sm-6 col-md-4 left">
									<div class="col-sm-12 col-md-6 mandatory">
										<label asp-for="changePassword.OldPassword" class="control-label"></label>
									</div>
									<div class="col-sm-12 col-md-8">
										<input type="password" asp-for="changePassword.OldPassword" class="form-control" />
										<span asp-validation-for="changePassword.OldPassword" class="text-danger"></span>
									</div>
								</div>
								<div class="col-sm-6 col-md-4 left">
									<div class="col-sm-12 col-md-6 mandatory">
										<label asp-for="changePassword.NewPassword" class="control-label"></label>
									</div>
									<div class="col-sm-12 col-md-8">
										<input type="password" asp-for="changePassword.NewPassword" class="form-control" />
										<span asp-validation-for="changePassword.NewPassword" class="text-danger"></span>
									</div>
								</div>
								<div class="col-sm-6 col-md-4 left">
									<div class="col-sm-12 col-md-6 mandatory">
										<label asp-for="changePassword.ConfirmPassword" class="control-label"></label>
									</div>
									<div class="col-sm-12 col-md-8">
										<input type="password" asp-for="changePassword.ConfirmPassword" class="form-control" />
										<span asp-validation-for="changePassword.ConfirmPassword" class="text-danger"></span>
									</div>
								</div>
							</div>
							<div class="form-group">
								<button type="submit" id="btnChangePassword" class="btn btn-success btn-mgn VUSYSbg"><i class="fas fa-save"></i> Change Password</button>
								<button type="button" id="btnChangePasswordClear" class="btn btn-secondary btn-mgn VUSYSbg" onclick="fnReset(this)"><i class="fas fa-reset"></i> Clear</button>
								@await Html.PartialAsync("CommonControls/_CancelButton")
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</section>
	@await Html.PartialAsync("AlertNotification/_AlertNotification")
</form>

