<div class="container">
    <div style="width:100%; margin:0 auto;">
        <table id="tblUserList" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
            <thead class="VUSYSTableHeader">
                <tr>
                    <th></th>
                    <th>UserID</th> 
                    <th>SL No.</th>
                    <th>User Name</th>
                    <th>Full Name</th>
                    <th>Mobile No.</th>
                    <th>Email ID</th>
                    <th>Role</th>
                    <th>Status</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        BindUserListGrid();
    });


    function BindUserListGrid() {
        var url = '@Url.Action("GetUserList", "Users")';
        var rtable = $("#tblUserList").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "scrollX": true,
            "scrollCollapse": true,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, 'All']],
            "paging": true,
            "ajax": {
                "url": url,
                "type": "POST",
                "datatype": "json"
            },
            "columnDefs": [{
                "targets": [1],
                "visible": false,
                "searchable": false
            }],
            "language": {
                "emptyTable": "No Record Found.",
                "processing":
                    '<i class="fa fa-spinner fa-spin fa-3x fa-fw" style="color:#2a2b2b;"></i><span class="sr-only">Loading...</span> '
            },
            "columns": [
                {
                    "data": "encryptedId",
                    "render": function (data) {
                        return `
                                    <div class="text-center" style="width:10px;">
                                            <a href="@Url.Action("EditUser", "Users")/?id=${data}" class="" data-toggle="tooltip" data-placement="top" title="Edit User Details" style="cursor:pointer"><i class="fas fa-pencil-alt"></i></a>
                                    </div>
                                   `;
                    }, "width": "3%"
                },
                { "data": "id", "name": "id", "width": "10%" },
                { "data": "slNo", "name": "slNo", "width": "0%" },
                { "data": "userName", "name": "userName", "width": "10%" },
                { "data": "fullName", "name": "fullName", "width": "10%" },
                { "data": "mobileNo", "name": "mobileNo", "width": "10%" },
                { "data": "userEmailID", "name": "userEmailID", "width": "10%" },
                { "data": "userRole", "name": "userRole", "width": "10%" },
                { "data": "activeStatus", "name": "activeStatus", "width": "10%" }
            ]

        });
    }
</script>

