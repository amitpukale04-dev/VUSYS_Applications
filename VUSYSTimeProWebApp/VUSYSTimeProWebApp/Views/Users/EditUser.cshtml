@model VUSYSTimeProWebApp.ViewModels.AllViewModel

@{
	ViewData["Title"] = "Edit User";
	Layout = "_CommonNavLayout";
}

<form id="EditUserForm" asp-action="EditUser" method="post" enctype="multipart/form-data">
	<section class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-primary">
						<div class="card-header VUSYSbg">
							<h3 class="card-title divcustombold">Edit User</h3>
						</div>
						<input type="hidden" asp-for="Users.Id" />
						<div class="card-body" style="padding-left:10px;">
							@await Html.PartialAsync("_AddEditUser")
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</form>