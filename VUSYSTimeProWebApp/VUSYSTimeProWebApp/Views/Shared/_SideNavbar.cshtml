@using Newtonsoft.Json
@{
	string appName = TempData.Peek("appName") as string ?? "";
}

<!-- Navbar -->
<nav class="main-header navbar navbar-expand navbar-white navbar-light bg-light px-2">
	<!-- Left navbar links -->
	<ul class="navbar-nav">
		<li class="nav-item">
			<a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
		</li>
		<li class="nav-item d-none d-sm-inline-block align-content-center">
			@Html.ActionLink("Home", "Home", "Home", new { @class = "nav-link" })
		</li>

	</ul>
	<a asp-action="Home" asp-controller="Home" class="brand-link w-100 text-center" style="color:#0094ff;">
		<span class="navbar-brand mx-auto d-block text-center font-weight-bold app-name-responsive text-bold">
			@appName
		</span>
	</a>
	@*<div class="form-inline">
		<div class="input-group" data-widget="sidebar-search">
			<input class="form-control" type="search" placeholder="Search" aria-label="Search">
			<div class="input-group-append">
				<button class="btn btn-sidebar">
					<i class="fas fa-search fa-fw"></i>
				</button>
			</div>
		</div>
	</div>*@
	<div class="form-inline ml-auto d-sm-flex w-100 justify-content-end">
		<div class="input-group input-group-sm" style="max-width: 250px; width: 100%;" data-widget="sidebar-search">
			<div class="input-group-prepend">
				<span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
			</div>
			<input class="form-control" type="search" placeholder="Search" aria-label="Search" style="background-color: #fff;">
		</div>
	</div>
	<ul class="navbar-nav">
		@{
			var SessionDetails = Context.Session.GetString("UserSession");
			if (SessionDetails != null)
			{
				var UserDetails = JsonConvert.DeserializeObject<UserLoggedInInfo>(SessionDetails);
				byte[] myimage = new byte[0];
				myimage = (byte[])UserDetails.UserImage;
				string strbase64 = Convert.ToBase64String(myimage);

				var UserProfileImage = "data:Image/jpg;base64," + strbase64;
				UserDetails.UserProfileImage = UserProfileImage;

				<li class="nav-item dropdown">
					<a class="nav-link user-panel d-flex" data-toggle="dropdown" href="#" style="border-radius: 50%; justify-content:center; align-items:center; position:relative;">
						<img src="@UserProfileImage" class="img-circle elevation-2" alt="User Image" style="width: 30px; height: 30px;">
					</a>
					<div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
						@await Html.PartialAsync("_LoggedInUserInfo", UserDetails)
						<div class="dropdown-divider"></div>
						<div class="dropdown-divider"></div>
						<a href="@Url.Action("UserProfile", "UserProfile")" class="dropdown-item">
							<i class="fas fa-users mr-2"></i> Your Profile
						</a>
						@{
							var IsChangePasswordAccess = Context.Session.GetString("IsChangePasswordAccess");
							if (IsChangePasswordAccess != null)
							{
								var IsChangePasswordAccessUserDetails = JsonConvert.DeserializeObject<bool>(IsChangePasswordAccess);
								if ((bool)IsChangePasswordAccessUserDetails)
								{
									<div class="dropdown-divider"></div>
									<a href="@Url.Action("ChangePassword", "ChangePassword")" class="dropdown-item">
										<i class="fas fa-lock mr-2"></i> Change Password
									</a>
								}
							}
						}
						<div class="dropdown-divider"></div>
						<a class="dropdown-item" href="#" onclick="return fnOpenLogoutConfirmation(this);">
							<i class="fas fa-sign-out-alt mr-2"></i> Logout
						</a>
						<div class="dropdown-divider"></div>
					</div>

				</li>
			}
		}
	</ul>
</nav>

@await Html.PartialAsync("_Greetings")

<aside class="main-sidebar sidebar-dark-primary elevation-2 VUSYSbg collapsed">
	<div class="sidebar">
		<nav class="mt-2">
			<ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
				@await Html.PartialAsync("_BindMenuList")
			</ul>
		</nav>
	</div>
</aside>