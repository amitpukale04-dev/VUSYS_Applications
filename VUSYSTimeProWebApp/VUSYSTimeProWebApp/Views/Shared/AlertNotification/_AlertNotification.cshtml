@if (TempData["SuccessMessage"] != null)
{
	<script type="text/javascript">
		window.onload = function () {
			ShowNotificationMessage('@TempData["SuccessMessage"]', "VUSYS Time Pro", "success", "center-center", 2000);
		};
	</script>
}
