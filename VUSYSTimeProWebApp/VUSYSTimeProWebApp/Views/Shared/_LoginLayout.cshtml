<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    @{
        string title = ViewData["Title"] as string ?? "";
        string appName = TempData.Peek("appName") as string ?? "VUSYS Time Pro";
    }
    <title>@title | @appName</title>
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/Admin/dist/img/AppLogo.png" />
    @*<link href="~/css/splash.css" rel="stylesheet" />*@
    <!-- Core Styles -->
    @await Html.PartialAsync("Sections/_LoginStyles")
    @await Html.PartialAsync("Sections/_LoginScripts")
</head>

<body>
    <!-- Layout Content -->
    @RenderBody()
    <!--/ Layout Content -->

    <!-- Core Scripts -->
    @section PageStyles {
        @RenderSection("PageStyles", required: false)
    }
    @RenderSection("PageScripts", required: false)
</body>

</html>
