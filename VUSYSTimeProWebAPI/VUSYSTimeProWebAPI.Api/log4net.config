<?xml version="1.0" encoding="utf-8" ?>
<log4net xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="ignore.xsd">

	<!-- Custom Log4Net File Appender -->
	<appender name="Log4NetFileAppender" type="VUSYSTimeProWebAPI.Api.Logging.Log4NetFileAppender, VUSYSTimeProWebAPI.Api">
		<!-- This value will be overridden in Program.cs -->
		<file value="Logs\\Default.log" />
		<appendToFile value="true" />
		<encoding value="utf-8" />
		<rollingStyle value="Once" />
		<staticLogFileName value="true" />
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%message%newline" />
		</layout>
	</appender>

	<!-- Optional Console Appender for Debugging -->
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %-5level %logger - %message%newline" />
		</layout>
	</appender>

	<!-- Root Logger Setup -->
	<root>
		<level value="ALL" />
		<appender-ref ref="Log4NetFileAppender" />
		<appender-ref ref="TraceAppender" />
		<!--<appender-ref ref="ConsoleAppender" />-->   <!-- Uncomment for debug output -->
	</root>

</log4net>
