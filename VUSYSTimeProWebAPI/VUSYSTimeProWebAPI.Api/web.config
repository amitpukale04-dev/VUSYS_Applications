<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<security>
				<requestFiltering>
					<!-- Set max file upload size to 500MB -->
					<requestLimits maxAllowedContentLength="524288000"/>
					<!-- 500MB in bytes -->
				</requestFiltering>
			</security>
			<applicationInitialization doAppInitAfterRestart="true">
				<add initializationPage="/swagger/index.html"/>
			</applicationInitialization>
			<handlers>
				<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified"/>
			</handlers>
			<aspNetCore processPath="dotnet" arguments=".\VUSYSTimeProWebAPI.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess"/>
		</system.webServer>
	</location>
</configuration>
