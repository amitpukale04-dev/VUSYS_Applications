    <Folder Include="Abstractions\Modules\OTPService\" />
    <Folder Include="Abstractions\Modules\Reports\" />
    <Folder Include="Abstractions\Services\" />
    <Folder Include="Common\Options\" />
    <Folder Include="Models\Authentication\" />
    <Folder Include="Models\Configuration\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CommonLibCore10">
      <HintPath>..\TOOLS\CommonLibCore10.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
