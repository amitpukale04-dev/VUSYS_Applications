<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- Optional: suppress missing doc warnings -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e9996e52-2cc0-4cf8-bc78-00ae0f84c6e6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CommonLibCore10">
      <HintPath>..\TOOLS\CommonLibCore10.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
