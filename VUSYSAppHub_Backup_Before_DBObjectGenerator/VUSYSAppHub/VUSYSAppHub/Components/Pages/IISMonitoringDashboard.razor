    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        try
        {
            _statusMonitorCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            if (_statusMonitorTask is not null)
                await _statusMonitorTask;
        }
        catch
        {
        }

        try
        {
            _statusMonitorCts?.Dispose();
        }
        catch
        {
        }

        try
        {
            if (scrollListenerRegistered)
                await JS.InvokeVoidAsync("appHubScroll.unregisterScrollListener");
        }
        catch
        {
        }

        try
        {
            _statusHttpClient.Dispose();
        }
        catch
        {
        }

        dotNetRef?.Dispose();
    }

