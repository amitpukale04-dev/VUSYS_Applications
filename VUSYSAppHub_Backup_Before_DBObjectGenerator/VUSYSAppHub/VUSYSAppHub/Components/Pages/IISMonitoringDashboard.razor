            ReadStringProperty(app, "AppPoolName") ??
            ReadStringProperty(app, "AppPool") ??
            ReadStringProperty(app, "PoolName") ??
            $"{app.ProductGroup}-{app.Environment}";
    }

    private string GetServerName(PortalApp app)
    {
        return
            ReadStringProperty(app, "ServerName") ??
            ReadStringProperty(app, "MachineName") ??
            ReadStringProperty(app, "HostServer") ??
            Environment.MachineName;
    }

    private string ResolveAggregateStatus(IEnumerable<string> statuses)
    {
        var normalized = statuses.Select(NormalizeStatus).ToList();

        if (normalized.Any(x => string.Equals(x, "Down", StringComparison.OrdinalIgnoreCase)))
            return "Down";

        if (normalized.Any(x => string.Equals(x, "Maintenance", StringComparison.OrdinalIgnoreCase)))
            return "Maintenance";

        return "Live";
    }

    private string GetAppUniqueKey(PortalApp app)
    {
        return $"{app.ProductGroup}||{app.Environment}||{app.Name}||{app.Url}";
    }

    private bool MatchesAppHealthSearch(MonitoringAppItem item, string? searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var term = searchText.Trim();

        return ContainsIgnoreCase(item.Name, term)
               || ContainsIgnoreCase(item.ProductGroup, term)
               || ContainsIgnoreCase(item.Environment, term)
               || ContainsIgnoreCase(item.Status, term)
               || ContainsIgnoreCase(item.Url, term);
    }

    private bool MatchesAppPoolSearch(AppPoolDashboardItem item, string? searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var term = searchText.Trim();

        return ContainsIgnoreCase(item.Name, term)
               || ContainsIgnoreCase(item.Environment, term)
               || ContainsIgnoreCase(item.ServerName, term)
               || ContainsIgnoreCase(item.Status, term)
               || item.AppCount.ToString().Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private static bool ContainsIgnoreCase(string? source, string value)
    {
        return !string.IsNullOrWhiteSpace(source)
               && source.Contains(value, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "Live";

        var value = status.Trim();

        if (value.Equals("down", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("offline", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("critical", StringComparison.OrdinalIgnoreCase))
            return "Down";

        if (value.Equals("maintenance", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("maint", StringComparison.OrdinalIgnoreCase) ||
            value.Equals("warning", StringComparison.OrdinalIgnoreCase))
            return "Maintenance";

        return "Live";
    }

    private static string? ReadStringProperty(object obj, string propertyName)
    {
        var prop = obj.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (prop is null)
            return null;

        var value = prop.GetValue(obj);
        return value?.ToString();
    }

    private static bool ReadBoolProperty(object obj, string propertyName)
    {
        var prop = obj.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        if (prop is null)
            return false;

        var value = prop.GetValue(obj);

        if (value is bool boolValue)
            return boolValue;

        if (value is string str && bool.TryParse(str, out var parsed))
            return parsed;

        return false;
    }

